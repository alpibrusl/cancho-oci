edition 7;

import std.buffer;
import std.io;
import oci.http;
import oci.secure;
import tls;

// http-probe: the test harness for `oci.http` (#9). One request, the response on stdout:
//
//     http-probe <host> <port> <METHOD> <path> [--tls <roots.pem>]
//
// With `--tls` the connection is TLS (cancho's own), trusting the roots in the PEM file.
//
// Prints `STATUS <n>`, then `HEAD <name>: <value>` for each of a few headers, then `BODY`,
// then the body exactly as decoded, piece by piece. A refusal is `refused: <rule tag>` on
// stderr and exit status 1.

fn number[&t](text: &t [byte]) -> [] int {
    var value = 0;
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c < '0' || c > '9' {
            return 0 - 1;
        }
        value = value * 10 + (c - '0');
        i = i + 1;
    }
    if len(text) == 0 {
        return 0 - 1;
    }
    return value;
}

fn show[&i, &e](io: &!i Io, ex: &e http.Exchange, name: &static [byte]) -> [io_write] int {
    let v = http.header(ex, name);
    if len(v) > 0 {
        io.write_all(io, "HEAD ");
        io.write_all(io, name);
        io.write_all(io, ": ");
        io.write_all(io, v);
        io.write_all(io, "\n");
    }
    return 0;
}

fn exchange[&h, &n, &i, &g, &e](heap: &!h Heap, net: &n Net(""), eng: &!e tls.Engine, now_ms: int, idle_ms: int, io: &!i Io, args: &g Args) -> [heap, args, net_out(""), conn_read, conn_write, poll, io_write, err_write] int {
    let host = arg(args, 1);
    let port = number(arg(args, 2));
    var req = buffer.empty(heap, 256);
    req = buffer.append(heap, req, arg(args, 3));
    req = buffer.append(heap, req, " ");
    req = buffer.append(heap, req, arg(args, 4));
    req = buffer.append(heap, req, " HTTP/1.1\r\nHost: ");
    req = buffer.append(heap, req, host);
    req = buffer.append(heap, req, ":");
    req = buffer.push_nat(heap, req, port);
    req = buffer.append(heap, req, "\r\nUser-Agent: http-probe\r\nConnection: close\r\n\r\n");
    var status = 1;
    match http.begin(heap, net, host, port, eng, now_ms, idle_ms) {
        http.Started::Failed(code) => {
            io.error_all(io, "refused: ");
            io.error_all(io, http.rule_name(code));
            io.error_all(io, "\n");
        }
        http.Started::Ok(first) => {
            var ex = first;
            var code = 0;
            borrow req as &rb in {
                let (next, c) = http.send(ex, eng, buffer.bytes(rb));
                ex = next;
                code = c;
            }
            if code == 0 {
                let (next, c) = http.read_head(ex, eng);
                ex = next;
                code = c;
            }
            if code == 0 {
                borrow ex as &er in {
                    io.write_all(io, "STATUS ");
                    io.print_nat(io, http.status(er));
                    io.write_all(io, "\n");
                    show(io, er, "content-type");
                    show(io, er, "content-length");
                    show(io, er, "location");
                    show(io, er, "docker-content-digest");
                    show(io, er, "www-authenticate");
                    io.write_all(io, "BODY\n");
                }
                let piece = box_slice(heap, 4096, byte_of(0));
                var going = true;
                while going {
                    borrow mut piece as &!pw in {
                        let (next, n) = http.read_body(ex, eng, contents(pw));
                        ex = next;
                        if n > 0 {
                            io.write_all(io, contents(pw)[0..n]);
                        } else {
                            going = false;
                            if n < 0 {
                                code = n;
                            }
                        }
                    }
                }
                unbox_slice(heap, piece);
            }
            borrow ex as &xr in {
                if http.transport_failure(xr) != 0 {
                    io.error_all(io, "transport: ");
                    io.error_all(io, tls.refusal_tag(http.transport_failure(xr)));
                    io.error_all(io, " (");
                    io.print_nat(io, 0 - http.transport_failure(xr));
                    io.error_all(io, ")");
                    io.error_all(io, "\n");
                }
            }
            http.end(heap, ex, eng);
            if code == 0 {
                status = 0;
            } else {
                io.error_all(io, "\nrefused: ");
                io.error_all(io, http.rule_name(code));
                io.error_all(io, "\n");
            }
        }
    }
    buffer.drop(heap, req);
    return status;
}

fn is_flag[&t, &n](text: &t [byte], flag: &n [byte]) -> [] bool {
    if len(text) != len(flag) {
        return false;
    }
    var k = 0;
    while k < len(flag) {
        if text[k] != flag[k] {
            return false;
        }
        k = k + 1;
    }
    return true;
}

fn usage[&i](io: &!i Io) -> [err_write] int {
    io.error_all(io, "usage: http-probe <host> <port> <METHOD> <path> [--tls <roots.pem>] [--timeout-s <n>]\n");
    return 1;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi);
    release(signals);
    release(exec);
    var status = 1;
    borrow mut heap as &!h in {
        borrow args as &g in {
            borrow net as &n in {
                borrow fs as &f in {
                    borrow clock as &k in {
                        borrow mut io as &!i in {
                            var roots = "";
                            var idle_s = 30;
                            var at = 5;
                            var bad = arg_count(g) < 5;
                            while !bad && at < arg_count(g) {
                                if at + 1 >= arg_count(g) {
                                    bad = true;
                                } else if is_flag(arg(g, at), "--tls") {
                                    roots = arg(g, at + 1);
                                } else if is_flag(arg(g, at), "--timeout-s") {
                                    idle_s = number(arg(g, at + 1));
                                    if idle_s < 1 {
                                        bad = true;
                                    }
                                } else {
                                    bad = true;
                                }
                                at = at + 2;
                            }
                            if bad {
                                status = usage(i);
                            } else if len(roots) > 0 {
                                let (eng0, ready) = secure.engine(h, f, roots);
                                var eng = eng0;
                                if ready != 0 {
                                    io.error_all(i, "refused: ");
                                    io.error_all(i, secure.rule_name(ready));
                                    io.error_all(i, "\n");
                                } else {
                                    borrow mut eng as &!ew in {
                                        status = exchange(h, n, ew, clock_unix_ms(k), idle_s * 1000, i, g);
                                    }
                                }
                                tls.close(h, eng);
                            } else {
                                var eng = tls.open(h, 1);
                                borrow mut eng as &!ew2 in {
                                    status = exchange(h, n, ew2, 0, idle_s * 1000, i, g);
                                }
                                tls.close(h, eng);
                            }
                        }
                    }
                }
            }
        }
    }
    release(heap);
    release(args);
    release(net);
    release(fs);
    release(clock);
    release(io);
    return status;
}
