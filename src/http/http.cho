edition 7;

module oci.http;

import tls;

// `oci.http` -- an HTTP/1.1 client, one exchange at a time (design 5.7, task #9). There
// is no client in cancho's packages (`http.request` reads a server's incoming
// requests), so this is it, and it is deliberately small: one connection per exchange
// (`Connection: close`), no keep-alive, no redirects followed (a registry's `Location`
// is data to be checked by the caller, not a hop to take), no compression.
//
// An `Exchange` owns the connection and its buffers. The caller sends a request head
// and body, reads the response head, then reads the body a piece at a time; a body is
// never held whole unless the caller chooses to. Three body framings are decoded:
// `Content-Length`, `Transfer-Encoding: chunked`, and "until the server closes".
//
// A response head is capped (16 KiB) and so is every line of it, so a server that never
// stops sending headers is refused, not buffered. What this cannot yet do, and says so:
// every wait for the peer (connecting, reading, writing) is bounded by an **idle deadline**: a peer that sends or accepts
// nothing for `idle_ms` is refused as `http-timeout`. That bounds a stall, not a trickle: a peer that sends one byte just
// before each deadline is still served (a total time limit is not built). Resolving a name is not bounded either.

pub fn head_cap() -> [] int {
    return 16384;
}

pub fn line_cap() -> [] int {
    return 8192;
}

pub fn refused_dial() -> [] int {
    return 0 - 801;
}

pub fn refused_send() -> [] int {
    return 0 - 802;
}

pub fn refused_truncated() -> [] int {
    return 0 - 803;
}

pub fn refused_head_too_large() -> [] int {
    return 0 - 804;
}

pub fn refused_malformed() -> [] int {
    return 0 - 805;
}

pub fn refused_body() -> [] int {
    return 0 - 806;
}

pub fn refused_timeout() -> [] int {
    return 0 - 807;
}

pub fn rule_name(code: int) -> [] &static [byte] {
    if code == refused_timeout() {
        return "http-timeout";
    }
    if code == refused_dial() {
        return "http-dial";
    }
    if code == refused_send() {
        return "http-send";
    }
    if code == refused_truncated() {
        return "http-truncated";
    }
    if code == refused_head_too_large() {
        return "http-head-too-large";
    }
    if code == refused_malformed() {
        return "http-malformed";
    }
    if code == refused_body() {
        return "http-body";
    }
    // a refusal of the TLS engine (-1 to -63) is named by the engine
    if code < 0 && code > 0 - 100 {
        return tls.refusal_tag(code);
    }
    return "unknown";
}

// st: 0 bytes in `buf`, 1 read position in `buf`, 2 status, 3 bytes of head, 4
//     Content-Length (-1 when absent), 5 chunked (1/0), 6 body mode (0 length,
//     1 chunked, 2 until close), 7 bytes left in the current length or chunk,
//     8 chunk state (0 size line next, 1 data, 2 CRLF after data, 3 done),
//     9 transport (0 plain, 1 TLS: the bytes go through slot 0 of the caller's engine),
//     10 the engine's refusal that ended a read (0 if none), 11 and 12 the ciphertext in `wire` the
//     engine has not taken yet (from, to)
// wire: for TLS, [0, 16384) holds ciphertext just read from the socket and [16384, 36864) ciphertext
//     on its way out; one byte for a plain exchange.
// A connection with the poller that waits on it, and how long a wait may last.
pub res struct Link {
    sock: Conn,
    poller: Poller,
    idle: int,
}

pub res struct Exchange {
    conn: Link,
    buf: Box[[byte]],
    st: Box[[int]],
    head: Box[[byte]],
    wire: Box[[byte]],
}

pub enum Started {
    Ok(Exchange),
    Failed(int),
}

fn wire_in() -> [] int {
    return 16384;
}

fn wire_len() -> [] int {
    return 36864;
}

// Wait until the socket is ready for `events` (1 to read, 2 to write), at most the link's idle time: 1 when it is,
// 0 when the time ran out, -1 on an error.
fn wait_for[&c](conn: &!c Link, events: int) -> [poll] int {
    if poller_modify(conn.poller, conn.sock, 1, events) < 0 {
        return 0 - 1;
    }
    var answer = 0 - 1;
    region a {
        let out = alloc_slice[a](8, 0);
        let n = poller_wait(conn.poller, out, conn.idle);
        if n > 0 {
            answer = 1;
        } else if n == 0 {
            answer = 0;
        }
    }
    return answer;
}

// Ciphertext the engine has queued, written to the socket. 0, -1 on a socket error, -2 when the peer took nothing for the
// idle time.
fn flush[&c, &e, &w](conn: &!c Link, eng: &!e tls.Engine, out: &!w [byte]) -> [conn_write, poll] int {
    var n = tls.take(eng, 0, out);
    while n > 0 {
        var at = 0;
        while at < n {
            match conn_write(conn.sock, out[at..n]) {
                Sent::Wrote(k) => {
                    if k <= 0 {
                        return 0 - 1;
                    }
                    at = at + k;
                }
                Sent::Again => {
                    let w = wait_for(conn, 2);
                    if w == 0 {
                        return 0 - 2;
                    }
                    if w < 0 {
                        return 0 - 1;
                    }
                }
                Sent::Failed(errno) => {
                    return 0 - 1;
                }
            }
        }
        n = tls.take(eng, 0, out);
    }
    return 0;
}

// `k` bytes of ciphertext at the start of `wire` given to the engine; whatever it answers is
// written. 0, a refusal of the engine (negative, from -1 to -63), or -1000 on a socket error.
fn pump[&c, &e, &w](conn: &!c Link, eng: &!e tls.Engine, wire: &!w [byte], k: int) -> [conn_write, poll] int {
    var at = 0;
    var idle = 0;
    while at < k {
        let used = tls.feed(eng, 0, wire[at..k]);
        if used < 0 {
            return used;
        }
        at = at + used;
        if used == 0 {
            idle = idle + 1;
            if idle > 4 {
                return 0 - 1000;
            }
        } else {
            idle = 0;
        }
        let fl = flush(conn, eng, wire[wire_in()..wire_len()]);
        if fl == 0 - 2 {
            return 0 - 1001;
        }
        if fl != 0 {
            return 0 - 1000;
        }
    }
    return 0;
}

// The handshake, driven to the end. 0, or the engine's refusal, or `refused_dial`.
fn handshake[&c, &e, &w](conn: &!c Link, eng: &!e tls.Engine, wire: &!w [byte]) -> [conn_read, conn_write, poll] int {
    var rounds = 0;
    while rounds < 64 {
        rounds = rounds + 1;
        let fl = flush(conn, eng, wire[wire_in()..wire_len()]);
        if fl == 0 - 2 {
            return refused_timeout();
        }
        if fl != 0 {
            return refused_dial();
        }
        let ev = tls.event(eng, 0);
        if ev == tls.event_established() {
            return 0;
        }
        if ev == tls.event_failed() {
            return tls.failure(eng, 0);
        }
        match conn_read(conn.sock, wire[0..wire_in()]) {
            Received::Data(k) => {
                let c = pump(conn, eng, wire, k);
                if c != 0 {
                    if c == 0 - 1000 {
                        return refused_dial();
                    }
                    if c == 0 - 1001 {
                        return refused_timeout();
                    }
                    return c;
                }
            }
            Received::End => {
                tls.eof(eng, 0);
                return tls.failure(eng, 0);
            }
            Received::Again => {
                let w = wait_for(conn, 1);
                if w == 0 {
                    return refused_timeout();
                }
                if w < 0 {
                    return refused_dial();
                }
            }
            Received::Failed(errno) => {
                return refused_dial();
            }
        }
    }
    return refused_dial();
}

// Plaintext from the transport into `out`: the count (at least 1), 0 at the end of the
// stream (for TLS: after the server's close_notify; a close without one is an error), -1 on an error.
// For TLS the ciphertext read from the socket waits in `wire` until the engine has room for it
// (`st` 11 and 12), so a read is never more than the engine can hold.
fn wire_read[&c, &e, &w, &s, &o](conn: &!c Link, eng: &!e tls.Engine, wire: &!w [byte], st: &!s [int], out: &!o [byte]) -> [conn_read, conn_write, poll] int {
    if st[9] == 0 {
        var waits = 0;
        while waits < 1000000 {
            waits = waits + 1;
            match conn_read(conn.sock, out) {
                Received::Data(n) => {
                    return n;
                }
                Received::End => {
                    return 0;
                }
                Received::Again => {
                    let w = wait_for(conn, 1);
                    if w == 0 {
                        st[10] = refused_timeout();
                        return 0 - 1;
                    }
                    if w < 0 {
                        return 0 - 1;
                    }
                }
                Received::Failed(errno) => {
                    return 0 - 1;
                }
            }
        }
        return 0 - 1;
    }
    var turns = 0;
    while turns < 1000000 {
        turns = turns + 1;
        let n = tls.recv(eng, 0, out);
        if n > 0 {
            return n;
        }
        if n == 0 {
            return 0;
        }
        if n != tls.would_block() {
            st[10] = n;
            return 0 - 1;
        }
        if st[11] < st[12] {
            // ciphertext the engine has not taken yet: it takes only what it has room to decrypt
            let used = tls.feed(eng, 0, wire[st[11]..st[12]]);
            if used < 0 {
                st[10] = used;
                return 0 - 1;
            }
            st[11] = st[11] + used;
            let fl = flush(conn, eng, wire[wire_in()..wire_len()]);
            if fl == 0 - 2 {
                st[10] = refused_timeout();
                return 0 - 1;
            }
            if fl != 0 || used == 0 {
                st[10] = 0 - 1000;
                return 0 - 1;
            }
        } else {
            match conn_read(conn.sock, wire[0..wire_in()]) {
                Received::Data(k) => {
                    st[11] = 0;
                    st[12] = k;
                }
                Received::End => {
                    tls.eof(eng, 0);
                    let m = tls.recv(eng, 0, out);
                    if m >= 0 {
                        return m;
                    }
                    st[10] = m;
                    return 0 - 1;
                }
                Received::Again => {
                    let w = wait_for(conn, 1);
                    if w == 0 {
                        st[10] = refused_timeout();
                        return 0 - 1;
                    }
                    if w < 0 {
                        return 0 - 1;
                    }
                }
                Received::Failed(errno) => {
                    return 0 - 1;
                }
            }
        }
    }
    return 0 - 1;
}

// Dial `host:port` (the builtin resolves names). One exchange, one connection. With `now_ms`
// (Unix milliseconds) above 0 the connection is TLS, to the name `host`, checked against the
// roots the engine was given and the certificates' dates against `now_ms`; with 0 it is plain.
// The engine is the caller's (`tls.trust` and `tls.seed` done); slot 0 is used and freed by `end`.
pub fn begin[&h, &n, &t, &e](heap: &!h Heap, net: &n Net(""), host: &t [byte], port: int, eng: &!e tls.Engine, now_ms: int, idle_ms: int) -> [heap, net_out(""), conn_read, conn_write, poll] Started {
    match poller_new() {
        Polling::Failed(errno) => {
            return Started::Failed(refused_dial());
        }
        Polling::Ok(poller) => {
            match tcp_connect_start(net, host, port) {
                Dialed::Failed(errno) => {
                    poller_close(poller);
                    return Started::Failed(refused_dial());
                }
                Dialed::Ok(sock) => {
                    var link = Link { sock: sock, poller: poller, idle: idle_ms };
                    var code = 0;
                    borrow mut link as &!lw in {
                        if poller_add_conn(lw.poller, lw.sock, 1, 2) < 0 {
                            code = refused_dial();
                        } else {
                            let w = wait_for(lw, 2);
                            if w == 0 {
                                code = refused_timeout();
                            } else if w < 0 || conn_connect_status(lw.sock) != 0 {
                                code = refused_dial();
                            }
                        }
                    }
                    if code != 0 {
                        close_link(link);
                        return Started::Failed(code);
                    }
                    let st = box_slice(heap, 13, 0);
                    borrow mut st as &!sw in {
                        contents(sw)[4] = 0 - 1;
                    }
                    var wire = box_slice(heap, 1, byte_of(0));
                    if now_ms > 0 {
                        unbox_slice(heap, wire);
                        wire = box_slice(heap, wire_len(), byte_of(0));
                        var tcode = tls.start(eng, 0, host, now_ms);
                        if tcode == 0 {
                            borrow mut link as &!cw in {
                                borrow mut wire as &!ww in {
                                    tcode = handshake(cw, eng, contents(ww));
                                }
                            }
                        }
                        if tcode != 0 {
                            tls.drop(eng, 0);
                            close_link(link);
                            unbox_slice(heap, st);
                            unbox_slice(heap, wire);
                            return Started::Failed(tcode);
                        }
                        borrow mut st as &!sw2 in {
                            contents(sw2)[9] = 1;
                        }
                    }
                    return Started::Ok(Exchange { conn: link, buf: box_slice(heap, 16384, byte_of(0)), st: st, head: box_slice(heap, 16384, byte_of(0)), wire: wire });
                }
            }
        }
    }
}

fn close_link(link: Link) -> [] int {
    let Link { sock, poller, idle } = link;
    conn_close(sock);
    poller_close(poller);
    return 0;
}

pub fn end[&h, &e](heap: &!h Heap, ex: Exchange, eng: &!e tls.Engine) -> [heap, conn_write, poll] int {
    let Exchange { conn, buf, st, head, wire } = ex;
    var c = conn;
    var secure = false;
    borrow st as &sr in {
        secure = contents(sr)[9] == 1;
    }
    if secure {
        tls.finish(eng, 0);
        borrow mut c as &!cw in {
            borrow mut wire as &!ww in {
                flush(cw, eng, contents(ww)[wire_in()..wire_len()]);
            }
        }
        tls.drop(eng, 0);
    }
    close_link(c);
    unbox_slice(heap, buf);
    unbox_slice(heap, st);
    unbox_slice(heap, head);
    unbox_slice(heap, wire);
    return 0;
}

// Write all of `bytes`. The exchange back and 0, or a refusal.
pub fn send[&b, &e](ex: Exchange, eng: &!e tls.Engine, bytes: &b [byte]) -> [conn_write, poll] (Exchange, int) {
    let Exchange { conn, buf, st, head, wire } = ex;
    var c = conn;
    var code = 0;
    var at = 0;
    var secure = false;
    borrow st as &sr in {
        secure = contents(sr)[9] == 1;
    }
    if secure {
        var stuck = 0;
        borrow mut c as &!cw in {
            borrow mut wire as &!ww in {
                while at < len(bytes) && code == 0 {
                    let k = tls.send(eng, 0, bytes[at..len(bytes)]);
                    if k < 0 {
                        code = refused_send();
                    } else {
                        at = at + k;
                        if k == 0 {
                            stuck = stuck + 1;
                        } else {
                            stuck = 0;
                        }
                        let fl = flush(cw, eng, contents(ww)[wire_in()..wire_len()]);
                        if fl == 0 - 2 {
                            code = refused_timeout();
                        } else if stuck > 2 || fl != 0 {
                            code = refused_send();
                        }
                    }
                }
            }
        }
        return (Exchange { conn: c, buf: buf, st: st, head: head, wire: wire }, code);
    }
    while at < len(bytes) && code == 0 {
        borrow mut c as &!cw in {
            match conn_write(cw.sock, bytes[at..len(bytes)]) {
                Sent::Wrote(n) => {
                    if n <= 0 {
                        code = refused_send();
                    } else {
                        at = at + n;
                    }
                }
                Sent::Again => {
                    let w = wait_for(cw, 2);
                    if w == 0 {
                        code = refused_timeout();
                    } else if w < 0 {
                        code = refused_send();
                    }
                }
                Sent::Failed(errno) => {
                    code = refused_send();
                }
            }
        }
    }
    return (Exchange { conn: c, buf: buf, st: st, head: head, wire: wire }, code);
}

// Refill the read buffer when it is empty. 1 when there are bytes, 0 at the end of the
// stream, -1 on an error.
fn fill[&c, &e, &w, &b, &s](conn: &!c Link, eng: &!e tls.Engine, wire: &!w [byte], buf: &!b [byte], st: &!s [int]) -> [conn_read, conn_write, poll] int {
    if st[1] < st[0] {
        return 1;
    }
    let n = wire_read(conn, eng, wire, st, buf);
    if n > 0 {
        st[0] = n;
        st[1] = 0;
        return 1;
    }
    return n;
}

// The next byte (0..255), -1 at the end of the stream, -2 on an error.
fn next_byte[&c, &e, &w, &b, &s](conn: &!c Link, eng: &!e tls.Engine, wire: &!w [byte], buf: &!b [byte], st: &!s [int]) -> [conn_read, conn_write, poll] int {
    let f = fill(conn, eng, wire, buf, st);
    if f == 0 {
        return 0 - 1;
    }
    if f < 0 {
        return 0 - 2;
    }
    let v = int_of(buf[st[1]]);
    st[1] = st[1] + 1;
    return v;
}

// One line, without its line ending, into `line`: its length; -1 at the end of the
// stream before any byte; -2 when the line would not fit; -3 on an error. A bare LF
// ends a line too (a lenient reader of the line, strict about where it ends).
fn read_line[&c, &e, &w, &b, &s, &l](conn: &!c Link, eng: &!e tls.Engine, wire: &!w [byte], buf: &!b [byte], st: &!s [int], line: &!l [byte]) -> [conn_read, conn_write, poll] int {
    var n = 0;
    var first = true;
    while true {
        let v = next_byte(conn, eng, wire, buf, st);
        if v == 0 - 1 {
            if first {
                return 0 - 1;
            }
            return 0 - 3;
        }
        if v < 0 {
            return 0 - 3;
        }
        first = false;
        if v == '\n' {
            if n > 0 && int_of(line[n - 1]) == '\r' {
                return n - 1;
            }
            return n;
        }
        if n >= len(line) {
            return 0 - 2;
        }
        line[n] = byte_of(v);
        n = n + 1;
    }
    return 0 - 3;
}

// Case-insensitive equality of `a` (a header name from the wire) with `b` (lower case).
fn same_name[&a, &b](x: &a [byte], y: &b [byte]) -> [] bool {
    if len(x) != len(y) {
        return false;
    }
    var i = 0;
    while i < len(x) {
        var c = int_of(x[i]);
        if c >= 'A' && c <= 'Z' {
            c = c + 32;
        }
        if c != int_of(y[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn number_in[&t](text: &t [byte]) -> [] int {
    var value = 0;
    var seen = false;
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c >= '0' && c <= '9' {
            if value > 100000000000000 {
                return 0 - 1;
            }
            value = value * 10 + (c - '0');
            seen = true;
        } else if c != ' ' && c != '\t' {
            return 0 - 1;
        }
        i = i + 1;
    }
    if !seen {
        return 0 - 1;
    }
    return value;
}

// The text of `bytes` between the first byte that is not a space and the last, as a view.
fn trim[&t](text: &t [byte]) -> [] &t [byte] {
    var a = 0;
    var b = len(text);
    while a < b && (int_of(text[a]) == ' ' || int_of(text[a]) == '\t') {
        a = a + 1;
    }
    while b > a && (int_of(text[b - 1]) == ' ' || int_of(text[b - 1]) == '\t' || int_of(text[b - 1]) == '\r') {
        b = b - 1;
    }
    return text[a..b];
}

// Read the response head: the status line and every header, into the exchange's head
// buffer (one header per line, "\n" separated), and decide how the body is framed.
// The exchange back and 0, or a refusal. The status is `status(ex)`.
pub fn read_head[&e](ex: Exchange, eng: &!e tls.Engine) -> [conn_read, conn_write, poll] (Exchange, int) {
    let Exchange { conn, buf, st, head, wire } = ex;
    var c = conn;
    var code = 0;
    borrow mut c as &!cw in {
        borrow mut wire as &!ww in {
            borrow mut buf as &!bw in {
                borrow mut st as &!sw in {
                    borrow mut head as &!hw in {
                        let b = contents(bw);
                        let s = contents(sw);
                        let h = contents(hw);
                        region a {
                            let line = alloc_slice[a](8192, byte_of(0));
                            var used = 0;
                            var n = read_line(cw, eng, contents(ww), b, s, line);
                            if n < 0 {
                                code = refused_truncated();
                                if n == 0 - 2 {
                                    code = refused_head_too_large();
                                }
                            } else if n < 12 || int_of(line[0]) != 'H' || int_of(line[1]) != 'T' || int_of(line[2]) != 'T' || int_of(line[3]) != 'P' || int_of(line[4]) != '/' {
                                code = refused_malformed();
                            } else {
                                // "HTTP/1.1 201 Created": the status is the three digits after the first space
                                var sp = 0;
                                while sp < n && int_of(line[sp]) != ' ' {
                                    sp = sp + 1;
                                }
                                let status = number_in(line[sp + 1..sp + 4]);
                                if sp + 4 > n || status < 100 || status > 599 {
                                    code = refused_malformed();
                                } else {
                                    s[2] = status;
                                    var going = true;
                                    while going && code == 0 {
                                        n = read_line(cw, eng, contents(ww), b, s, line);
                                        if n < 0 {
                                            code = refused_truncated();
                                            if n == 0 - 2 {
                                                code = refused_head_too_large();
                                            }
                                        } else if n == 0 {
                                            going = false;
                                        } else if used + n + 1 > len(h) {
                                            code = refused_head_too_large();
                                        } else {
                                            var k = 0;
                                            while k < n {
                                                h[used + k] = line[k];
                                                k = k + 1;
                                            }
                                            h[used + n] = byte_of('\n');
                                            used = used + n + 1;
                                        }
                                    }
                                    s[3] = used;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if code != 0 {
        borrow st as &tr in {
            if contents(tr)[10] == refused_timeout() {
                code = refused_timeout();
            }
        }
    }
    let ex2 = Exchange { conn: c, buf: buf, st: st, head: head, wire: wire };
    if code != 0 {
        return (ex2, code);
    }
    return frame(ex2);
}

// The value of header `name` (lower case) in `h` (the head, one header per line), trimmed,
// or an empty view.
fn header_in[&t, &n](h: &t [byte], name: &n [byte]) -> [] &t [byte] {
    var at = 0;
    while at < len(h) {
        var end = at;
        while end < len(h) && int_of(h[end]) != '\n' {
            end = end + 1;
        }
        var colon = at;
        while colon < end && int_of(h[colon]) != ':' {
            colon = colon + 1;
        }
        if colon < end && same_name(h[at..colon], name) {
            return trim(h[colon + 1..end]);
        }
        at = end + 1;
    }
    return h[0..0];
}

// The value of header `name` (lower case) in the response, trimmed, or an empty view.
pub fn header[&e, &n](ex: &e Exchange, name: &n [byte]) -> [] &e [byte] {
    return header_in(contents(ex.head)[0..contents(ex.st)[3]], name);
}

// The TLS engine's refusal that ended a read, or 0: what `http-truncated` hides when the cause was the
// connection's security and not its length.
pub fn transport_failure[&e](ex: &e Exchange) -> [] int {
    let v = contents(ex.st)[10];
    if v < 0 && v > 0 - 100 {
        return v;
    }
    return 0;
}

pub fn status[&e](ex: &e Exchange) -> [] int {
    return contents(ex.st)[2];
}

// Decide the body framing from the headers: chunked wins over a length (RFC 9112 6.3);
// a length that is not a number, or two that differ, is a refusal.
fn frame(ex: Exchange) -> [] (Exchange, int) {
    let Exchange { conn, buf, st, head, wire } = ex;
    var code = 0;
    borrow head as &hr in {
        borrow mut st as &!sw in {
            let s = contents(sw);
            let h = contents(hr)[0..s[3]];
            let te = header_in(h, "transfer-encoding");
            let cl = header_in(h, "content-length");
            var mode = 2;
            var length = 0 - 1;
            if len(cl) > 0 {
                length = number_in(cl);
                if length < 0 {
                    code = refused_malformed();
                } else {
                    mode = 0;
                }
            }
            if len(te) > 0 {
                if same_name(te, "chunked") {
                    mode = 1;
                } else {
                    code = refused_malformed();
                }
            }
            s[4] = length;
            s[5] = 0;
            if mode == 1 {
                s[5] = 1;
            }
            s[6] = mode;
            s[7] = length;
            s[8] = 0;
            // No body for these, whatever the headers say.
            if s[2] == 204 || s[2] == 304 || s[2] >= 100 && s[2] < 200 {
                s[6] = 0;
                s[7] = 0;
            }
        }
    }
    return (Exchange { conn: conn, buf: buf, st: st, head: head, wire: wire }, code);
}

// Up to `want` bytes of body into `out`: from the read buffer if it holds any, else
// straight from the connection. The count (at least 1), 0 when the stream ends, -1 on an error.
fn pull[&c, &e, &w, &b, &s, &o](conn: &!c Link, eng: &!e tls.Engine, wire: &!w [byte], buf: &!b [byte], st: &!s [int], out: &!o [byte], want: int) -> [conn_read, conn_write, poll] int {
    var room = want;
    if room > len(out) {
        room = len(out);
    }
    if room < 1 {
        return 0 - 1;
    }
    if st[1] < st[0] {
        var n = st[0] - st[1];
        if n > room {
            n = room;
        }
        var i = 0;
        while i < n {
            out[i] = buf[st[1] + i];
            i = i + 1;
        }
        st[1] = st[1] + n;
        return n;
    }
    return wire_read(conn, eng, wire, st, out[0..room]);
}

// A chunk-size line: hexadecimal digits, then optionally ";extension". The size, or -1.
fn chunk_size[&t](line: &t [byte]) -> [] int {
    var value = 0;
    var seen = false;
    var i = 0;
    while i < len(line) {
        let c = int_of(line[i]);
        var d = 0 - 1;
        if c >= '0' && c <= '9' {
            d = c - '0';
        } else if c >= 'a' && c <= 'f' {
            d = c - 'a' + 10;
        } else if c >= 'A' && c <= 'F' {
            d = c - 'A' + 10;
        }
        if d < 0 {
            if c == ';' || c == ' ' || c == '\t' {
                i = len(line);
            } else {
                return 0 - 1;
            }
        } else {
            if value > 1152921504606846975 / 16 {
                return 0 - 1;
            }
            value = value * 16 + d;
            seen = true;
            i = i + 1;
        }
    }
    if !seen {
        return 0 - 1;
    }
    return value;
}

// The next piece of the body into `out` (never more than `len(out)` bytes): its length,
// 0 when the body is complete, or a refusal (`http-truncated`: the stream ended early;
// `http-body`: bad chunk framing). The exchange is handed back for the next call.
pub fn read_body[&o, &e](ex: Exchange, eng: &!e tls.Engine, out: &!o [byte]) -> [conn_read, conn_write, poll] (Exchange, int) {
    let Exchange { conn, buf, st, head, wire } = ex;
    var c = conn;
    var result = 0;
    borrow mut c as &!cw in {
        borrow mut wire as &!ww in {
            borrow mut buf as &!bw in {
                borrow mut st as &!sw in {
                    let b = contents(bw);
                    let s = contents(sw);
                    if s[6] == 0 {
                        if s[7] > 0 {
                            let n = pull(cw, eng, contents(ww), b, s, out, s[7]);
                            if n > 0 {
                                s[7] = s[7] - n;
                                result = n;
                            } else {
                                result = refused_truncated();
                            }
                        }
                    } else if s[6] == 2 {
                        let n = pull(cw, eng, contents(ww), b, s, out, len(out));
                        if n > 0 {
                            result = n;
                        } else if n < 0 {
                            result = refused_truncated();
                        }
                    } else {
                        var going = true;
                        while going {
                            going = false;
                            if s[8] == 0 {
                                region a {
                                    let line = alloc_slice[a](128, byte_of(0));
                                    let n = read_line(cw, eng, contents(ww), b, s, line);
                                    if n < 0 {
                                        result = refused_truncated();
                                    } else {
                                        let size = chunk_size(line[0..n]);
                                        if size < 0 {
                                            result = refused_body();
                                        } else if size == 0 {
                                            s[8] = 3;
                                            // trailers, up to the blank line that ends the message
                                            var more = true;
                                            while more && result == 0 {
                                                let t = read_line(cw, eng, contents(ww), b, s, line);
                                                if t < 0 {
                                                    result = refused_truncated();
                                                } else if t == 0 {
                                                    more = false;
                                                }
                                            }
                                        } else {
                                            s[7] = size;
                                            s[8] = 1;
                                            going = true;
                                        }
                                    }
                                }
                            } else if s[8] == 1 {
                                let n = pull(cw, eng, contents(ww), b, s, out, s[7]);
                                if n > 0 {
                                    s[7] = s[7] - n;
                                    if s[7] == 0 {
                                        s[8] = 2;
                                    }
                                    result = n;
                                } else {
                                    result = refused_truncated();
                                }
                            } else if s[8] == 2 {
                                region a2 {
                                    let line = alloc_slice[a2](8, byte_of(0));
                                    let n = read_line(cw, eng, contents(ww), b, s, line);
                                    if n != 0 {
                                        result = refused_body();
                                    } else {
                                        s[8] = 0;
                                        going = true;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if result < 0 {
        borrow st as &tr in {
            if contents(tr)[10] == refused_timeout() {
                result = refused_timeout();
            }
        }
    }
    return (Exchange { conn: c, buf: buf, st: st, head: head, wire: wire }, result);
}
