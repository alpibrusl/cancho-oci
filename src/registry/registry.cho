edition 7;

module oci.registry;

import tls;

import oci.digest;
import oci.http;
import oci.layout;
import oci.store;
import std.buffer;
import std.json;

// `oci.registry` -- the client half of the OCI Distribution protocol (design 5.7, task #9):
// is a blob there, upload it, put a manifest. Every response is checked rather than
// believed: an upload's `Location` may only point back at the same host, the digest a
// registry reports for what it stored must be the digest we computed, and an error is a
// refusal that names the status and the first error code the registry gave.
//
// Authentication is HTTP Basic, sent on every request when credentials are given. A
// bearer-token challenge is answered by `negotiate` before anything is sent (token realm on the same
// host only), and one met later is refused by name (`registry-auth-bearer`), not guessed at.
//
// Each call is one or two exchanges on fresh connections (`oci.http` does not keep a
// connection alive), so there is no connection state to get wrong.

pub fn refused_unauthorized() -> [] int {
    return 0 - 901;
}

pub fn refused_denied() -> [] int {
    return 0 - 902;
}

pub fn refused_not_found() -> [] int {
    return 0 - 903;
}

pub fn refused_rejected() -> [] int {
    return 0 - 904;
}

pub fn refused_server() -> [] int {
    return 0 - 905;
}

pub fn refused_unexpected() -> [] int {
    return 0 - 906;
}

pub fn refused_location() -> [] int {
    return 0 - 907;
}

pub fn refused_redirect() -> [] int {
    return 0 - 908;
}

pub fn refused_digest() -> [] int {
    return 0 - 909;
}

pub fn refused_bearer() -> [] int {
    return 0 - 910;
}

pub fn refused_name() -> [] int {
    return 0 - 911;
}

pub fn refused_size() -> [] int {
    return 0 - 912;
}

pub fn refused_media() -> [] int {
    return 0 - 913;
}

pub fn refused_creds() -> [] int {
    return 0 - 914;
}

pub fn refused_token() -> [] int {
    return 0 - 915;
}

pub fn refused_realm() -> [] int {
    return 0 - 916;
}

pub fn rule_name(code: int) -> [] &static [byte] {
    if code == refused_unauthorized() {
        return "registry-unauthorized";
    }
    if code == refused_denied() {
        return "registry-denied";
    }
    if code == refused_not_found() {
        return "registry-not-found";
    }
    if code == refused_rejected() {
        return "registry-rejected";
    }
    if code == refused_server() {
        return "registry-server-error";
    }
    if code == refused_unexpected() {
        return "registry-unexpected-status";
    }
    if code == refused_location() {
        return "registry-location";
    }
    if code == refused_redirect() {
        return "registry-redirect-foreign-host";
    }
    if code == refused_digest() {
        return "registry-digest-mismatch";
    }
    if code == refused_bearer() {
        return "registry-auth-bearer";
    }
    if code == refused_name() {
        return "registry-name";
    }
    if code == refused_size() {
        return "registry-size-mismatch";
    }
    if code == refused_media() {
        return "registry-media-type";
    }
    if code == refused_creds() {
        return "registry-credentials-file";
    }
    if code == refused_token() {
        return "registry-token";
    }
    if code == refused_realm() {
        return "registry-token-realm";
    }
    if code == refused_referrers() {
        return "registry-referrers-unreadable";
    }
    return http.rule_name(code);
}

// ---- Basic authentication --------------------------------------------------------------

fn b64_digit(n: int) -> [] int {
    if n < 26 {
        return 'A' + n;
    }
    if n < 52 {
        return 'a' + n - 26;
    }
    if n < 62 {
        return '0' + n - 52;
    }
    if n == 62 {
        return '+';
    }
    return '/';
}

// RFC 4648 section 4, with padding.
fn base64[&h, &t](heap: &!h Heap, out: buffer.Buffer, data: &t [byte]) -> [heap] buffer.Buffer {
    var b = out;
    var i = 0;
    while i < len(data) {
        let x = int_of(data[i]);
        var y = 0;
        var z = 0;
        if i + 1 < len(data) {
            y = int_of(data[i + 1]);
        }
        if i + 2 < len(data) {
            z = int_of(data[i + 2]);
        }
        let n = x * 65536 + y * 256 + z;
        b = buffer.push(heap, b, byte_of(b64_digit(n >> 18 & 63)));
        b = buffer.push(heap, b, byte_of(b64_digit(n >> 12 & 63)));
        if i + 1 < len(data) {
            b = buffer.push(heap, b, byte_of(b64_digit(n >> 6 & 63)));
        } else {
            b = buffer.push(heap, b, byte_of('='));
        }
        if i + 2 < len(data) {
            b = buffer.push(heap, b, byte_of(b64_digit(n & 63)));
        } else {
            b = buffer.push(heap, b, byte_of('='));
        }
        i = i + 3;
    }
    return b;
}

// "Authorization: Basic <base64 of user:password>\r\n" for `credentials` ("user:password"), or
// an empty buffer for none.
pub fn auth_line[&h, &c](heap: &!h Heap, credentials: &c [byte]) -> [heap] buffer.Buffer {
    var b = buffer.empty(heap, 64);
    if len(credentials) == 0 {
        return b;
    }
    b = buffer.append(heap, b, "Authorization: Basic ");
    b = base64(heap, b, credentials);
    return buffer.append(heap, b, "\r\n");
}

// ---- one request, one reply -------------------------------------------------------------

// What came back: the status, the three headers that matter, and the start of the body
// (up to 64 KiB; an error body is only ever read for its message).
pub res struct Reply {
    status: int,
    location: buffer.Buffer,
    content_digest: buffer.Buffer,
    challenge: buffer.Buffer,
    body: buffer.Buffer,
}

fn empty_reply[&h](heap: &!h Heap) -> [heap] Reply {
    return Reply { status: 0, location: buffer.empty(heap, 1), content_digest: buffer.empty(heap, 1), challenge: buffer.empty(heap, 1), body: buffer.empty(heap, 1) };
}

pub fn drop_reply[&h](heap: &!h Heap, reply: Reply) -> [heap] int {
    let Reply { status, location, content_digest, challenge, body } = reply;
    buffer.drop(heap, location);
    buffer.drop(heap, content_digest);
    buffer.drop(heap, challenge);
    buffer.drop(heap, body);
    return status;
}

pub fn reply_status[&r](reply: &r Reply) -> [] int {
    return reply.status;
}

pub fn reply_location[&r](reply: &r Reply) -> [] &r [byte] {
    return buffer.bytes(reply.location);
}

pub fn reply_digest[&r](reply: &r Reply) -> [] &r [byte] {
    return buffer.bytes(reply.content_digest);
}

pub fn reply_challenge[&r](reply: &r Reply) -> [] &r [byte] {
    return buffer.bytes(reply.challenge);
}

pub fn reply_body[&r](reply: &r Reply) -> [] &r [byte] {
    return buffer.bytes(reply.body);
}

fn body_cap() -> [] int {
    return 65536;
}

// "METHOD path HTTP/1.1", Host, User-Agent, the auth line, Content-Type and Content-Length
// when there is a body, Connection: close, and the blank line.
fn request_head[&h, &m, &p, &t, &a, &c](heap: &!h Heap, method: &m [byte], path: &p [byte], host: &t [byte], port: int, auth: &a [byte], content_type: &c [byte], length: int) -> [heap] buffer.Buffer {
    var b = buffer.empty(heap, 512);
    b = buffer.append(heap, b, method);
    b = buffer.append(heap, b, " ");
    b = buffer.append(heap, b, path);
    b = buffer.append(heap, b, " HTTP/1.1\r\nHost: ");
    b = buffer.append(heap, b, host);
    // the scheme's own port is left out of Host, as every client does: a signed URL may be signed over the header
    if port != 443 && port != 80 {
        b = buffer.append(heap, b, ":");
        b = buffer.push_nat(heap, b, port);
    }
    b = buffer.append(heap, b, "\r\nUser-Agent: cancho-oci\r\nAccept: */*\r\n");
    b = buffer.append(heap, b, auth);
    if len(content_type) > 0 {
        b = buffer.append(heap, b, "Content-Type: ");
        b = buffer.append(heap, b, content_type);
        b = buffer.append(heap, b, "\r\n");
    }
    if length >= 0 {
        b = buffer.append(heap, b, "Content-Length: ");
        b = buffer.push_nat(heap, b, length);
        b = buffer.append(heap, b, "\r\n");
    }
    return buffer.append(heap, b, "Connection: close\r\n\r\n");
}

// Read the response: head, the headers worth keeping, and the start of the body. Ends the
// exchange. (Reply, 0) or (an empty reply, a refusal).
fn read_reply[&h, &tl](heap: &!h Heap, eng: &!tl tls.Engine, ex: http.Exchange, has_body: bool, cap: int) -> [heap, conn_read, conn_write] (Reply, int) {
    var e = ex;
    let (next, code) = http.read_head(e, eng);
    e = next;
    if code != 0 {
        http.end(heap, e, eng);
        return (empty_reply(heap), code);
    }
    var reply = empty_reply(heap);
    var seen = 0;
    borrow e as &er in {
        seen = http.status(er);
        let Reply { status, location, content_digest, challenge, body } = reply;
        reply = Reply { status: seen, location: buffer.append(heap, location, http.header(er, "location")), content_digest: buffer.append(heap, content_digest, http.header(er, "docker-content-digest")), challenge: buffer.append(heap, challenge, http.header(er, "www-authenticate")), body: body };
    }
    let piece = box_slice(heap, 4096, byte_of(0));
    var failed = 0;
    // A reply to HEAD has no body, whatever Content-Length says (RFC 9110 9.3.2).
    var going = has_body;
    while going {
        borrow mut piece as &!pw in {
            let (more, n) = http.read_body(e, eng, contents(pw));
            e = more;
            if n > 0 {
                let Reply { status, location, content_digest, challenge, body } = reply;
                var held = 0;
                borrow body as &bb in {
                    held = buffer.size(bb);
                }
                var kept = body;
                if held < cap {
                    kept = buffer.append(heap, kept, contents(pw)[0..n]);
                }
                reply = Reply { status: status, location: location, content_digest: content_digest, challenge: challenge, body: kept };
            } else {
                going = false;
                if n < 0 {
                    failed = n;
                }
            }
        }
    }
    unbox_slice(heap, piece);
    http.end(heap, e, eng);
    if failed != 0 && seen != 0 {
        // A truncated *error* body is still an error: keep the status, drop the detail.
        if seen >= 400 {
            return (reply, 0);
        }
        drop_reply(heap, reply);
        return (empty_reply(heap), failed);
    }
    return (reply, 0);
}

// A request with an in-memory body (possibly empty). Answers the reply and 0, or an empty
// reply and an `oci.http` refusal.
pub fn round_trip[&h, &n, &t, &a, &m, &p, &c, &b, &tl](heap: &!h Heap, net: &n Net(""), eng: &!tl tls.Engine, now_ms: int, host: &t [byte], port: int, auth: &a [byte], method: &m [byte], path: &p [byte], content_type: &c [byte], body: &b [byte]) -> [heap, net_out(""), conn_read, conn_write] (Reply, int) {
    let head = request_head(heap, method, path, host, port, auth, content_type, len(body));
    var result = empty_reply(heap);
    var code = 0;
    match http.begin(heap, net, host, port, eng, now_ms) {
        http.Started::Failed(c) => {
            code = c;
        }
        http.Started::Ok(first) => {
            var ex = first;
            borrow head as &hb in {
                let (next, c1) = http.send(ex, eng, buffer.bytes(hb));
                ex = next;
                code = c1;
            }
            if code == 0 && len(body) > 0 {
                let (next, c2) = http.send(ex, eng, body);
                ex = next;
                code = c2;
            }
            if code == 0 {
                drop_reply(heap, result);
                let (reply, c3) = read_reply(heap, eng, ex, !digest.equal(method, "HEAD"), body_cap());
                result = reply;
                code = c3;
            } else {
                http.end(heap, ex, eng);
            }
        }
    }
    buffer.drop(heap, head);
    return (result, code);
}

// GET with a body cap of `cap` bytes (a manifest or an index, which is read whole): the reply, or an
// empty reply and a refusal. A body larger than the cap is not an error here: the caller sees only the
// start and its digest will not match, which is the right refusal.
pub fn round_trip_get[&h, &n, &t, &a, &p, &c, &tl](heap: &!h Heap, net: &n Net(""), eng: &!tl tls.Engine, now_ms: int, host: &t [byte], port: int, extra: &a [byte], path: &p [byte], cap: int) -> [heap, net_out(""), conn_read, conn_write] (Reply, int) {
    let head = request_head(heap, "GET", path, host, port, extra, "", 0 - 1);
    var result = empty_reply(heap);
    var code = 0;
    match http.begin(heap, net, host, port, eng, now_ms) {
        http.Started::Failed(c) => {
            code = c;
        }
        http.Started::Ok(first) => {
            var ex = first;
            borrow head as &hb in {
                let (next, c1) = http.send(ex, eng, buffer.bytes(hb));
                ex = next;
                code = c1;
            }
            if code == 0 {
                drop_reply(heap, result);
                let (reply, c3) = read_reply(heap, eng, ex, true, cap);
                result = reply;
                code = c3;
            } else {
                http.end(heap, ex, eng);
            }
        }
    }
    buffer.drop(heap, head);
    return (result, code);
}

// A request whose body is `size` bytes read from `file` (a blob being uploaded), streamed in
// 64 KiB pieces: never held whole. The file must hold exactly `size` bytes.
pub fn round_trip_file[&h, &n, &t, &a, &m, &p, &c, &f, &tl](heap: &!h Heap, net: &n Net(""), eng: &!tl tls.Engine, now_ms: int, host: &t [byte], port: int, auth: &a [byte], method: &m [byte], path: &p [byte], content_type: &c [byte], file: &!f File, size: int) -> [heap, net_out(""), conn_read, conn_write, file_read] (Reply, int) {
    let head = request_head(heap, method, path, host, port, auth, content_type, size);
    var result = empty_reply(heap);
    var code = 0;
    match http.begin(heap, net, host, port, eng, now_ms) {
        http.Started::Failed(c) => {
            code = c;
        }
        http.Started::Ok(first) => {
            var ex = first;
            borrow head as &hb in {
                let (next, c1) = http.send(ex, eng, buffer.bytes(hb));
                ex = next;
                code = c1;
            }
            let chunk = box_slice(heap, 65536, byte_of(0));
            var sent = 0;
            var going = code == 0;
            while going {
                borrow mut chunk as &!cw in {
                    let room = contents(cw);
                    match file_read(file, room) {
                        Read::Got(got) => {
                            sent = sent + got;
                            if sent > size {
                                code = http.refused_send();
                                going = false;
                            } else {
                                let (next, c2) = http.send(ex, eng, room[0..got]);
                                ex = next;
                                if c2 != 0 {
                                    code = c2;
                                    going = false;
                                }
                            }
                        }
                        Read::End => {
                            going = false;
                        }
                        Read::Failed(errno) => {
                            code = http.refused_send();
                            going = false;
                        }
                    }
                }
            }
            unbox_slice(heap, chunk);
            if code == 0 && sent != size {
                code = http.refused_send();
            }
            if code == 0 {
                drop_reply(heap, result);
                let (reply, c3) = read_reply(heap, eng, ex, true, body_cap());
                result = reply;
                code = c3;
            } else {
                http.end(heap, ex, eng);
            }
        }
    }
    buffer.drop(heap, head);
    return (result, code);
}

// ---- mapping a status to a refusal ------------------------------------------------------

// Success statuses are the caller's to list; everything else becomes a refusal here.
pub fn refusal_of[&r](reply: &r Reply) -> [] int {
    let s = reply.status;
    if s == 401 {
        if len(buffer.bytes(reply.challenge)) >= 6 && digest.equal(buffer.bytes(reply.challenge)[0..6], "Bearer") {
            return refused_bearer();
        }
        return refused_unauthorized();
    }
    if s == 403 {
        return refused_denied();
    }
    if s == 404 {
        return refused_not_found();
    }
    if s >= 400 && s < 500 {
        return refused_rejected();
    }
    if s >= 500 {
        return refused_server();
    }
    return refused_unexpected();
}

// Does a repository name satisfy the spec's grammar (lower case components of letters,
// digits and . _ - separated by /)? A name that does not is refused before it reaches a URL.
pub fn name_ok[&t](name: &t [byte]) -> [] bool {
    if len(name) == 0 || len(name) > 255 {
        return false;
    }
    var prev_sep = true;
    var i = 0;
    while i < len(name) {
        let c = int_of(name[i]);
        let alnum = c >= 'a' && c <= 'z' || c >= '0' && c <= '9';
        let sep = c == '.' || c == '_' || c == '-' || c == '/';
        if !alnum && !sep {
            return false;
        }
        if sep && prev_sep {
            return false;
        }
        prev_sep = sep;
        i = i + 1;
    }
    return !prev_sep;
}

// "/v2/<repo>/<kind>/<tail>"
fn api_path[&h, &r, &k, &t](heap: &!h Heap, repo: &r [byte], kind: &k [byte], tail: &t [byte]) -> [heap] buffer.Buffer {
    var b = buffer.empty(heap, 128);
    b = buffer.append(heap, b, "/v2/");
    b = buffer.append(heap, b, repo);
    b = buffer.append(heap, b, "/");
    b = buffer.append(heap, b, kind);
    b = buffer.append(heap, b, "/");
    return buffer.append(heap, b, tail);
}

// Is the blob there? 0 when it is, 1 when it is not (404, or a registry that does not answer
// HEAD: the upload will say), or a refusal for anything that is an error in itself
// (authentication, a server fault).
pub fn blob_status[&h, &n, &t, &a, &r, &d, &tl](heap: &!h Heap, net: &n Net(""), eng: &!tl tls.Engine, now_ms: int, host: &t [byte], port: int, auth: &a [byte], repo: &r [byte], digest_text: &d [byte]) -> [heap, net_out(""), conn_read, conn_write] int {
    let path = api_path(heap, repo, "blobs", digest_text);
    var answer = 1;
    borrow path as &pb in {
        let (reply, code) = round_trip(heap, net, eng, now_ms, host, port, auth, "HEAD", buffer.bytes(pb), "", "");
        if code != 0 {
            answer = code;
        } else {
            borrow reply as &rr in {
                let s = reply_status(rr);
                if s == 200 {
                    answer = 0;
                } else if s == 404 || s == 405 {
                    answer = 1;
                } else {
                    answer = refusal_of(rr);
                }
            }
        }
        drop_reply(heap, reply);
    }
    buffer.drop(heap, path);
    return answer;
}

// The path (and query) an upload's `Location` names, made only from what the registry gave
// and only if it stays on this host. A path starting with "/" is used as it is; an absolute
// URL must name this host and port (the port may be left out when it is the scheme's own); anything else is a refusal. `digest=<digest>` is
// appended as the spec requires. Answers the path and 0, or an empty buffer and a refusal.
pub fn upload_target[&h, &l, &t, &d](heap: &!h Heap, location: &l [byte], host: &t [byte], port: int, digest_text: &d [byte]) -> [heap] (buffer.Buffer, int) {
    var path = buffer.empty(heap, 128);
    var start = 0;
    var code = 0;
    if len(location) == 0 {
        code = refused_location();
    } else if int_of(location[0]) == '/' {
        start = 0;
    } else {
        // an absolute URL: scheme://host[:port]/...
        let colon = index_of_byte(location, byte_of(':'));
        if colon < 1 || colon + 3 > len(location) || int_of(location[colon + 1]) != '/' || int_of(location[colon + 2]) != '/' {
            code = refused_location();
        } else {
            var end = colon + 3;
            while end < len(location) && int_of(location[end]) != '/' {
                end = end + 1;
            }
            // the authority must be exactly host:port (this tool always writes the port in `Host`)
            var want = buffer.empty(heap, 64);
            want = buffer.append(heap, want, host);
            want = buffer.append(heap, want, ":");
            want = buffer.push_nat(heap, want, port);
            var same = false;
            borrow want as &wb in {
                same = digest.equal(location[colon + 3..end], buffer.bytes(wb));
            }
            buffer.drop(heap, want);
            // a registry on the scheme's own port may leave the port out (Docker Hub does): `https://host/...` is host:443
            let scheme = location[0..colon];
            if port == 443 && digest.equal(scheme, "https") && digest.equal(location[colon + 3..end], host) {
                same = true;
            }
            if port == 80 && digest.equal(scheme, "http") && digest.equal(location[colon + 3..end], host) {
                same = true;
            }
            if !same {
                code = refused_redirect();
            } else if end >= len(location) {
                code = refused_location();
            } else {
                start = end;
            }
        }
    }
    if code != 0 {
        return (path, code);
    }
    path = buffer.append(heap, path, location[start..len(location)]);
    var has_query = false;
    borrow path as &pb in {
        has_query = index_of_byte(buffer.bytes(pb), byte_of('?')) >= 0;
    }
    if has_query {
        path = buffer.append(heap, path, "&digest=");
    } else {
        path = buffer.append(heap, path, "?digest=");
    }
    path = buffer.append(heap, path, digest_text);
    return (path, 0);
}

// Open an upload session: POST, and the path (with the digest appended) its `Location` names, which must stay on this host.
// The path and 0, or an empty buffer and a refusal.
fn upload_session[&h, &n, &t, &a, &r, &d, &tl](heap: &!h Heap, net: &n Net(""), eng: &!tl tls.Engine, now_ms: int, host: &t [byte], port: int, auth: &a [byte], repo: &r [byte], digest_text: &d [byte]) -> [heap, net_out(""), conn_read, conn_write] (buffer.Buffer, int) {
    var answer = 0;
    var opened = api_path(heap, repo, "blobs", "uploads/");
    var location = buffer.empty(heap, 1);
    borrow opened as &ob in {
        let (reply, code) = round_trip(heap, net, eng, now_ms, host, port, auth, "POST", buffer.bytes(ob), "", "");
        if code != 0 {
            answer = code;
        } else {
            borrow reply as &rr in {
                if reply_status(rr) == 202 {
                    location = buffer.append(heap, location, reply_location(rr));
                } else {
                    answer = refusal_of(rr);
                }
            }
        }
        drop_reply(heap, reply);
    }
    buffer.drop(heap, opened);
    var target = buffer.empty(heap, 1);
    if answer == 0 {
        borrow location as &lb in {
            let (t2, c2) = upload_target(heap, buffer.bytes(lb), host, port, digest_text);
            buffer.drop(heap, target);
            target = t2;
            answer = c2;
        }
    }
    buffer.drop(heap, location);
    return (target, answer);
}

// What a finished PUT of a blob must have answered: 201 or 200, and a reported digest, if any, that is ours.
fn upload_done[&r, &d](reply: &r Reply, digest_text: &d [byte]) -> [] int {
    if reply_status(reply) == 201 || reply_status(reply) == 200 {
        let shown = reply_digest(reply);
        if len(shown) > 0 && !digest.equal(shown, digest_text) {
            return refused_digest();
        }
        return 0;
    }
    return refusal_of(reply);
}

// Upload the blob in `file` (exactly `size` bytes, named `digest_text`): a session, then one PUT of the whole body to
// the session's `Location`. 0, or a refusal.
pub fn blob_upload[&h, &n, &t, &a, &r, &d, &f, &tl](heap: &!h Heap, net: &n Net(""), eng: &!tl tls.Engine, now_ms: int, host: &t [byte], port: int, auth: &a [byte], repo: &r [byte], digest_text: &d [byte], size: int, file: &!f File) -> [heap, net_out(""), conn_read, conn_write, file_read] int {
    let (target, answer0) = upload_session(heap, net, eng, now_ms, host, port, auth, repo, digest_text);
    var answer = answer0;
    if answer == 0 {
        borrow target as &tb in {
            let (reply, code) = round_trip_file(heap, net, eng, now_ms, host, port, auth, "PUT", buffer.bytes(tb), "application/octet-stream", file, size);
            if code != 0 {
                answer = code;
            } else {
                borrow reply as &rr in {
                    answer = upload_done(rr, digest_text);
                }
            }
            drop_reply(heap, reply);
        }
    }
    buffer.drop(heap, target);
    return answer;
}

// The same for a blob held in memory.
pub fn blob_upload_bytes[&h, &n, &t, &a, &r, &d, &b, &tl](heap: &!h Heap, net: &n Net(""), eng: &!tl tls.Engine, now_ms: int, host: &t [byte], port: int, auth: &a [byte], repo: &r [byte], digest_text: &d [byte], bytes: &b [byte]) -> [heap, net_out(""), conn_read, conn_write] int {
    let (target, answer0) = upload_session(heap, net, eng, now_ms, host, port, auth, repo, digest_text);
    var answer = answer0;
    if answer == 0 {
        borrow target as &tb in {
            let (reply, code) = round_trip(heap, net, eng, now_ms, host, port, auth, "PUT", buffer.bytes(tb), "application/octet-stream", bytes);
            if code != 0 {
                answer = code;
            } else {
                borrow reply as &rr in {
                    answer = upload_done(rr, digest_text);
                }
            }
            drop_reply(heap, reply);
        }
    }
    buffer.drop(heap, target);
    return answer;
}

// PUT a manifest (or an index) at `reference` (a tag or a digest). The registry must
// report the digest of what it stored, if it reports one at all, and that must be ours.
pub fn manifest_put[&h, &n, &t, &a, &r, &x, &m, &b, &d, &tl](heap: &!h Heap, net: &n Net(""), eng: &!tl tls.Engine, now_ms: int, host: &t [byte], port: int, auth: &a [byte], repo: &r [byte], reference: &x [byte], media: &m [byte], body: &b [byte], digest_text: &d [byte]) -> [heap, net_out(""), conn_read, conn_write] int {
    let path = api_path(heap, repo, "manifests", reference);
    var answer = 0;
    borrow path as &pb in {
        let (reply, code) = round_trip(heap, net, eng, now_ms, host, port, auth, "PUT", buffer.bytes(pb), media, body);
        if code != 0 {
            answer = code;
        } else {
            borrow reply as &rr in {
                let s = reply_status(rr);
                if s == 201 || s == 200 {
                    let shown = reply_digest(rr);
                    if len(shown) > 0 && !digest.equal(shown, digest_text) {
                        answer = refused_digest();
                    }
                } else {
                    answer = refusal_of(rr);
                }
            }
        }
        drop_reply(heap, reply);
    }
    buffer.drop(heap, path);
    return answer;
}

// The refusal for a bare status (no reply object): 401 as unauthorized, or as the bearer challenge
// when `bearer` says the server asked for one.
fn refusal_of_status(s: int, bearer: bool) -> [] int {
    if s == 401 {
        if bearer {
            return refused_bearer();
        }
        return refused_unauthorized();
    }
    if s == 403 {
        return refused_denied();
    }
    if s == 404 {
        return refused_not_found();
    }
    if s >= 400 && s < 500 {
        return refused_rejected();
    }
    if s >= 500 {
        return refused_server();
    }
    return refused_unexpected();
}

// Fetch a manifest or an index by tag or digest, whole (at most 1 MiB), and prove it: the digest
// of the bytes is computed here, and must equal `reference` when that is a digest and the digest the
// registry reports when it reports one. Answers the bytes and 0, or an empty buffer and a refusal.
// `shown` receives the digest text of what was fetched (71 bytes).
pub fn manifest_fetch[&h, &n, &t, &a, &r, &x, &o, &tl](heap: &!h Heap, net: &n Net(""), eng: &!tl tls.Engine, now_ms: int, host: &t [byte], port: int, auth: &a [byte], repo: &r [byte], reference: &x [byte], shown: &!o [byte]) -> [heap, net_out(""), conn_read, conn_write] (buffer.Buffer, int) {
    var extra = buffer.append(heap, buffer.empty(heap, 256), auth);
    extra = buffer.append(heap, extra, "Accept: application/vnd.oci.image.index.v1+json, application/vnd.oci.image.manifest.v1+json\r\n");
    let path = api_path(heap, repo, "manifests", reference);
    var out = buffer.empty(heap, 1);
    var code = 0;
    borrow extra as &eb in {
        borrow path as &pb in {
            let (reply, c) = round_trip_get(heap, net, eng, now_ms, host, port, buffer.bytes(eb), buffer.bytes(pb), 1048576);
            code = c;
            if c == 0 {
                borrow reply as &rr in {
                    if reply_status(rr) != 200 {
                        code = refusal_of(rr);
                    } else {
                        let body = reply_body(rr);
                        var raw = 0;
                        region w {
                            let sum = alloc_slice[w](32, byte_of(0));
                            digest.of_bytes(body, sum);
                            digest.text_into(sum, shown);
                        }
                        if len(reply_digest(rr)) > 0 && !digest.equal(reply_digest(rr), shown) {
                            code = refused_digest();
                        } else if len(reference) == 71 && digest.equal(reference[0..7], "sha256:") && !digest.equal(reference, shown) {
                            code = refused_digest();
                        } else {
                            buffer.drop(heap, out);
                            out = buffer.append(heap, buffer.empty(heap, len(body) + 1), body);
                        }
                    }
                }
            }
            drop_reply(heap, reply);
        }
    }
    buffer.drop(heap, extra);
    buffer.drop(heap, path);
    return (out, code);
}

// The code `blob_get` answers when the registry sent the client elsewhere (the Location is in `moved_to`).
fn moved_code() -> [] int {
    return 3;
}

// Where a blob redirect may go (the blob store of a registry is often a CDN on another host; ghcr.io does this): the
// request head for it, the host and the port. Only the scheme the registry itself uses is followed (https for https; plain
// HTTP only to a loopback host), with no userinfo, a plain host name and a plain absolute path. A path on this host keeps the
// credentials; a URL does not get them: it is a signed address meant to be used by whoever holds it.
// Answers (head, host, port, code); the head and host are empty on a refusal.
fn next_hop[&h, &l, &t, &a](heap: &!h Heap, location: &l [byte], host: &t [byte], port: int, secure: bool, auth: &a [byte]) -> [heap] (buffer.Buffer, buffer.Buffer, int, int) {
    var head = buffer.empty(heap, 1);
    var next_host = buffer.empty(heap, 1);
    var next_port = port;
    var code = 0;
    var prefix = "http://";
    if secure {
        prefix = "https://";
    }
    var k = 0;
    while k < len(location) {
        let c = int_of(location[k]);
        if c < 33 || c > 126 {
            code = refused_redirect();
        }
        k = k + 1;
    }
    if len(location) == 0 || len(location) > 4000 {
        code = refused_redirect();
    }
    if code == 0 {
        if int_of(location[0]) == '/' && !(len(location) > 1 && int_of(location[1]) == '/') {
            next_host = buffer.append(heap, next_host, host);
            buffer.drop(heap, head);
            head = request_head(heap, "GET", location, host, port, auth, "", 0 - 1);
        } else if len(location) > len(prefix) && digest.equal(location[0..len(prefix)], prefix) {
            let rest = location[len(prefix)..len(location)];
            var slash = 0;
            while slash < len(rest) && int_of(rest[slash]) != '/' {
                slash = slash + 1;
            }
            if slash == 0 || slash >= len(rest) {
                code = refused_redirect();
            } else {
                let authority = rest[0..slash];
                var colon = index_of_byte(authority, byte_of(':'));
                var name = authority;
                next_port = 443;
                if !secure {
                    next_port = 80;
                }
                if colon >= 0 {
                    name = authority[0..colon];
                    next_port = port_of(authority[colon + 1..len(authority)]);
                }
                var j = 0;
                while j < len(name) {
                    let c = int_of(name[j]);
                    if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '-' || c == '.') {
                        code = refused_redirect();
                    }
                    j = j + 1;
                }
                if len(name) == 0 || next_port < 1 {
                    code = refused_redirect();
                }
                if code == 0 && !secure && !is_loopback(name) {
                    code = refused_redirect();
                }
                if code == 0 {
                    next_host = buffer.append(heap, next_host, name);
                    buffer.drop(heap, head);
                    head = request_head(heap, "GET", rest[slash..len(rest)], name, next_port, "", "", 0 - 1);
                }
            }
        } else {
            code = refused_redirect();
        }
    }
    if code != 0 {
        buffer.drop(heap, head);
        buffer.drop(heap, next_host);
        return (buffer.empty(heap, 1), buffer.empty(heap, 1), 0, code);
    }
    return (head, next_host, next_port, 0);
}

// Download the blob `digest_text` into the store under the temporary name `tmp`, a piece at a time,
// and publish it only if it is `size` bytes (when `size` is not negative) and hashes to its name.
// The descriptor's size is the bound: a body is refused as soon as it passes it (so at most one piece
// beyond it is ever read), whatever the registry announces or whether it announces anything.
// 0, or a refusal; on a refusal nothing is left in the store.
fn blob_get[&h, &n, &t, &q, &w, &b, &m, &l, &tl](heap: &!h Heap, net: &n Net(""), eng: &!tl tls.Engine, now_ms: int, host: &t [byte], port: int, head: &q [byte], want: &w [byte], size: int, blobs: &b Dir, tmp: &m [byte], moved_to: &!l [byte]) -> [heap, net_out(""), conn_read, conn_write, dir_write, file_write] (int, int) {
    var code = 0;
    var moved = 0;
    region w {
        if code == 0 {
            match http.begin(heap, net, host, port, eng, now_ms) {
                http.Started::Failed(c) => {
                    code = c;
                }
                http.Started::Ok(first) => {
                    var ex = first;
                    let (next, c1) = http.send(ex, eng, head);
                    ex = next;
                    code = c1;
                    if code == 0 {
                        let (next, c2) = http.read_head(ex, eng);
                        ex = next;
                        code = c2;
                    }
                    if code == 0 {
                        var statuscode = 0;
                        borrow ex as &er in {
                            statuscode = http.status(er);
                        }
                        if statuscode == 301 || statuscode == 302 || statuscode == 303 || statuscode == 307 || statuscode == 308 {
                            // where to go next: the caller decides whether that is allowed
                            borrow ex as &lr in {
                                let place = http.header(lr, "location");
                                if len(place) == 0 || len(place) > len(moved_to) {
                                    code = refused_redirect();
                                } else {
                                    var k = 0;
                                    while k < len(place) {
                                        moved_to[k] = place[k];
                                        k = k + 1;
                                    }
                                    moved = len(place);
                                    code = moved_code();
                                }
                            }
                        } else if statuscode != 200 {
                            code = refusal_of_status(statuscode, false);
                        } else {
                            match store.begin(heap, blobs, tmp) {
                                store.Began::Failed(c3) => {
                                    code = store.refused_io();
                                }
                                store.Began::Ok(first_blob) => {
                                    var blob = first_blob;
                                    let piece = box_slice(heap, 65536, byte_of(0));
                                    var total = 0;
                                    var going = true;
                                    while going && code == 0 {
                                        borrow mut piece as &!pw in {
                                            let (more, n) = http.read_body(ex, eng, contents(pw));
                                            ex = more;
                                            if n > 0 {
                                                total = total + n;
                                                if size >= 0 && total > size {
                                                    code = refused_size();
                                                } else {
                                                    let (nb, errno) = store.write(blob, contents(pw)[0..n]);
                                                    blob = nb;
                                                    if errno != 0 {
                                                        code = store.refused_io();
                                                    }
                                                }
                                            } else {
                                                going = false;
                                                if n < 0 {
                                                    code = n;
                                                }
                                            }
                                        }
                                    }
                                    unbox_slice(heap, piece);
                                    if code == 0 && size >= 0 && total != size {
                                        code = refused_size();
                                    }
                                    if code == 0 {
                                        let scratch = alloc_slice[w](32, byte_of(0));
                                        let outcome = store.finish_expecting(heap, blobs, blob, tmp, scratch, want);
                                        if outcome <= 0 {
                                            code = outcome;
                                            if outcome == store.refused_mismatch() {
                                                code = refused_digest();
                                            }
                                        }
                                    } else {
                                        store.abandon(heap, blobs, blob, tmp);
                                    }
                                }
                            }
                        }
                    }
                    http.end(heap, ex, eng);
                }
            }
        }
    }
    return (code, moved);
}

pub fn blob_fetch[&h, &n, &t, &a, &r, &d, &b, &m, &tl](heap: &!h Heap, net: &n Net(""), eng: &!tl tls.Engine, now_ms: int, host: &t [byte], port: int, auth: &a [byte], repo: &r [byte], digest_text: &d [byte], size: int, blobs: &b Dir, tmp: &m [byte]) -> [heap, net_out(""), conn_read, conn_write, dir_write, file_write] int {
    var code = 0;
    region w {
        let want = alloc_slice[w](32, byte_of(0));
        if digest.parse_into(digest_text, want) != 0 {
            code = refused_digest();
        } else {
            let path = api_path(heap, repo, "blobs", digest_text);
            var head = buffer.empty(heap, 1);
            borrow path as &pq in {
                buffer.drop(heap, head);
                head = request_head(heap, "GET", buffer.bytes(pq), host, port, auth, "", 0 - 1);
            }
            buffer.drop(heap, path);
            var at_host = buffer.append(heap, buffer.empty(heap, 1), host);
            var at_port = port;
            let where_to = box_slice(heap, 4096, byte_of(0));
            var hops = 0;
            var going = true;
            while going {
                going = false;
                var length = 0;
                borrow head as &hb in {
                    borrow at_host as &hn in {
                        borrow mut where_to as &!ww in {
                            let (c, n2) = blob_get(heap, net, eng, now_ms, buffer.bytes(hn), at_port, buffer.bytes(hb), want, size, blobs, tmp, contents(ww));
                            code = c;
                            length = n2;
                        }
                    }
                }
                if code == moved_code() {
                    hops = hops + 1;
                    if hops > 3 {
                        code = refused_redirect();
                    } else {
                        borrow where_to as &wr in {
                            let (next_head, next_name, next_port, c4) = next_hop(heap, contents(wr)[0..length], host, port, now_ms > 0, auth);
                            code = c4;
                            if code == 0 {
                                buffer.drop(heap, head);
                                head = next_head;
                                buffer.drop(heap, at_host);
                                at_host = next_name;
                                at_port = next_port;
                                going = true;
                            } else {
                                buffer.drop(heap, next_head);
                                buffer.drop(heap, next_name);
                            }
                        }
                    }
                }
            }
            unbox_slice(heap, where_to);
            buffer.drop(heap, head);
            buffer.drop(heap, at_host);
        }
    }
    return code;
}

// ---- what both command-line tools need -------------------------------------------------------

// A tag or digest the registry will accept as a reference: letters, digits, "_", ".", "-"
// (a tag, at most 128 bytes), or "sha256:<hex>".
pub fn reference_ok[&t](text: &t [byte]) -> [] bool {
    if len(text) == 0 || len(text) > 128 {
        return false;
    }
    if len(text) == 71 && digest.equal(text[0..7], "sha256:") {
        return len(layout.hex_of(text)) == 64;
    }
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        let alnum = c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9';
        if !alnum && c != '_' && c != '.' && c != '-' {
            return false;
        }
        if i == 0 && (c == '.' || c == '-') {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn is_loopback[&t](host: &t [byte]) -> [] bool {
    return digest.equal(host, "127.0.0.1") || digest.equal(host, "localhost") || digest.equal(host, "::1");
}

// A decimal port 1..65535 from `text`, or -1.
pub fn port_of[&t](text: &t [byte]) -> [] int {
    if len(text) == 0 || len(text) > 5 {
        return 0 - 1;
    }
    var value = 0;
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c < '0' || c > '9' {
            return 0 - 1;
        }
        value = value * 10 + (c - '0');
        i = i + 1;
    }
    if value < 1 || value > 65535 {
        return 0 - 1;
    }
    return value;
}

// Read a credentials file: one line, `user:password`, at most 1 KiB. The text (without its
// line ending) and 0, or an empty buffer and `push_creds()`.
pub fn read_credentials[&h, &f, &p](heap: &!h Heap, fs: &f Fs(""), path: &p [byte]) -> [heap, fs_read("")] (buffer.Buffer, int) {
    var out = buffer.empty(heap, 64);
    var code = 0;
    region a {
        let raw = alloc_slice[a](1024, byte_of(0));
        let n = fs_read(fs, path, raw);
        if n <= 0 {
            code = refused_creds();
        } else {
            var end = n;
            while end > 0 && (int_of(raw[end - 1]) == '\n' || int_of(raw[end - 1]) == '\r') {
                end = end - 1;
            }
            let line = raw[0..end];
            if index_of_byte(line, byte_of(':')) < 1 || index_of_byte(line, byte_of('\n')) >= 0 {
                code = refused_creds();
            } else {
                out = buffer.append(heap, out, line);
            }
        }
    }
    return (out, code);
}

// ---- the Bearer token flow (the Docker token authentication scheme; what ghcr.io and Docker Hub use)

// The value of `name="..."` in a challenge, or an empty view. No escapes are read: a backslash makes it empty.
fn param_of[&c, &n](challenge: &c [byte], name: &n [byte]) -> [] &c [byte] {
    var i = 0;
    while i + len(name) + 2 <= len(challenge) {
        let before = i == 0 || int_of(challenge[i - 1]) == ' ' || int_of(challenge[i - 1]) == ',';
        if before && digest.equal(challenge[i..i + len(name)], name) && int_of(challenge[i + len(name)]) == '=' && int_of(challenge[i + len(name) + 1]) == '"' {
            let from = i + len(name) + 2;
            var j = from;
            while j < len(challenge) && int_of(challenge[j]) != '"' {
                if int_of(challenge[j]) == '\\' {
                    return challenge[0..0];
                }
                j = j + 1;
            }
            if j >= len(challenge) {
                return challenge[0..0];
            }
            return challenge[from..j];
        }
        i = i + 1;
    }
    return challenge[0..0];
}

// Is `c` a character allowed in a token the client will put in a header? (Letters, digits and `-._~+/=:,`: a JWT, a
// base64 string, a scope-shaped token. Anything else, a space or a line break above all, is refused.)
fn token_char(c: int) -> [] bool {
    return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '-' || c == '.' || c == '_' || c == '~' || c == '+' || c == '/' || c == '=' || c == ':' || c == ',';
}

// `text` percent-encoded for a query value, but for the characters a scope uses.
fn query_value[&h, &t](heap: &!h Heap, out: buffer.Buffer, text: &t [byte]) -> [heap] buffer.Buffer {
    var b = out;
    let hex = "0123456789ABCDEF";
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if token_char(c) && c != '+' && c != '=' {
            b = buffer.push(heap, b, text[i]);
        } else {
            b = buffer.push(heap, b, byte_of('%'));
            b = buffer.push(heap, b, hex[c >> 4..(c >> 4) + 1][0]);
            b = buffer.push(heap, b, hex[c & 15..(c & 15) + 1][0]);
        }
        i = i + 1;
    }
    return b;
}

// Where the token is asked for, from the challenge's `realm`: the path (with a query started) on the registry's own host,
// or a refusal. The realm must be `https://` (`http://` when the registry is plain HTTP), name this host and port, and have a
// plain absolute path. A token endpoint on another host is refused: the credentials would go there.
fn realm_path[&h, &r, &t](heap: &!h Heap, realm: &r [byte], host: &t [byte], port: int, secure: bool) -> [heap] (buffer.Buffer, int) {
    var scheme = "http://";
    var default_port = 80;
    if secure {
        scheme = "https://";
        default_port = 443;
    }
    var out = buffer.empty(heap, 64);
    if len(realm) <= len(scheme) || !digest.equal(realm[0..len(scheme)], scheme) {
        return (out, refused_realm());
    }
    let rest = realm[len(scheme)..len(realm)];
    var slash = 0;
    while slash < len(rest) && int_of(rest[slash]) != '/' {
        slash = slash + 1;
    }
    if slash >= len(rest) {
        return (out, refused_realm());
    }
    let authority = rest[0..slash];
    let path = rest[slash..len(rest)];
    var expected = buffer.empty(heap, 32);
    expected = buffer.append(heap, expected, host);
    expected = buffer.append(heap, expected, ":");
    expected = buffer.push_nat(heap, expected, port);
    var same = false;
    borrow expected as &eb in {
        same = digest.equal(authority, buffer.bytes(eb));
    }
    if port == default_port && digest.equal(authority, host) {
        same = true;
    }
    buffer.drop(heap, expected);
    var k = 0;
    while k < len(path) {
        let c = int_of(path[k]);
        if !(token_char(c) && c != ',' && c != ':') {
            same = false;
        }
        k = k + 1;
    }
    if !same {
        return (out, refused_realm());
    }
    out = buffer.append(heap, out, path);
    return (out, 0);
}

// Ask `realm` for a token for `repo`: the Authorization line, or a refusal. See `negotiate`.
fn ask_token[&h, &n, &t, &a, &r, &m, &s, &tl](heap: &!h Heap, net: &n Net(""), eng: &!tl tls.Engine, now_ms: int, host: &t [byte], port: int, secure: bool, basic: &a [byte], repo: &r [byte], push: bool, realm: &m [byte], service: &s [byte]) -> [heap, net_out(""), conn_read, conn_write] (buffer.Buffer, int) {
    var line = buffer.empty(heap, 1);
    let (path, c1) = realm_path(heap, realm, host, port, secure);
    var code = c1;
    var query = path;
    if code == 0 {
        query = buffer.append(heap, query, "?");
        if len(service) > 0 {
            query = buffer.append(heap, query, "service=");
            query = query_value(heap, query, service);
            query = buffer.append(heap, query, "&");
        }
        query = buffer.append(heap, query, "scope=");
        var scope = buffer.empty(heap, 64);
        scope = buffer.append(heap, scope, "repository:");
        scope = buffer.append(heap, scope, repo);
        scope = buffer.append(heap, scope, ":pull");
        if push {
            scope = buffer.append(heap, scope, ",push");
        }
        borrow scope as &sb in {
            query = query_value(heap, query, buffer.bytes(sb));
        }
        buffer.drop(heap, scope);
        borrow query as &qb in {
            let (answer, c2) = round_trip_get(heap, net, eng, now_ms, host, port, basic, buffer.bytes(qb), 16384);
            code = c2;
            if code == 0 {
                borrow answer as &ar in {
                    if reply_status(ar) == 401 {
                        code = refused_unauthorized();
                    } else if reply_status(ar) != 200 {
                        code = refused_token();
                    } else {
                        let body = reply_body(ar);
                        region a {
                            let tape = alloc_slice[a](layout.tape_ints(body), 0);
                            if json.parse(body, tape) < 0 {
                                code = refused_token();
                            } else {
                                var token = layout.text_of(body, tape, 0, "token");
                                if len(token) == 0 {
                                    token = layout.text_of(body, tape, 0, "access_token");
                                }
                                var good = len(token) > 0;
                                var k = 0;
                                while k < len(token) {
                                    if !token_char(int_of(token[k])) {
                                        good = false;
                                    }
                                    k = k + 1;
                                }
                                if !good {
                                    code = refused_token();
                                } else {
                                    line = buffer.append(heap, line, "Authorization: Bearer ");
                                    line = buffer.append(heap, line, token);
                                    line = buffer.append(heap, line, "\r\n");
                                }
                            }
                        }
                    }
                }
            }
            drop_reply(heap, answer);
        }
    }
    buffer.drop(heap, query);
    if code != 0 {
        buffer.drop(heap, line);
        return (buffer.empty(heap, 1), code);
    }
    return (line, 0);
}

// The Authorization line to use for `repo` on this registry, found before anything is sent to it. `GET /v2/` answers 200
// (no token needed: `basic`, the credentials' line, is kept) or 401 with a challenge. A `Bearer` challenge is answered by
// asking its realm, on this host only, for a token for `repository:<repo>:pull` (and `push` when `push`), with the Basic
// credentials if there are any, and the token goes in `Authorization: Bearer`. The line and 0, or an empty line and a refusal.
pub fn negotiate[&h, &n, &t, &a, &r, &tl](heap: &!h Heap, net: &n Net(""), eng: &!tl tls.Engine, now_ms: int, host: &t [byte], port: int, secure: bool, basic: &a [byte], repo: &r [byte], push: bool) -> [heap, net_out(""), conn_read, conn_write] (buffer.Buffer, int) {
    let (probe, c0) = round_trip_get(heap, net, eng, now_ms, host, port, basic, "/v2/", 16384);
    if c0 != 0 {
        drop_reply(heap, probe);
        return (buffer.empty(heap, 1), c0);
    }
    var wanted = false;
    var realm_text = buffer.empty(heap, 1);
    var service_text = buffer.empty(heap, 1);
    borrow probe as &pr in {
        if reply_status(pr) == 401 && len(reply_challenge(pr)) >= 7 && digest.equal(reply_challenge(pr)[0..7], "Bearer ") {
            wanted = true;
            realm_text = buffer.append(heap, realm_text, param_of(reply_challenge(pr), "realm"));
            service_text = buffer.append(heap, service_text, param_of(reply_challenge(pr), "service"));
        }
    }
    drop_reply(heap, probe);
    var line = buffer.empty(heap, 1);
    var code = 0;
    if !wanted {
        line = buffer.append(heap, line, basic);
    } else {
        borrow realm_text as &rb in {
            borrow service_text as &sb in {
                let (got, c) = ask_token(heap, net, eng, now_ms, host, port, secure, basic, repo, push, buffer.bytes(rb), buffer.bytes(sb));
                buffer.drop(heap, line);
                line = got;
                code = c;
            }
        }
    }
    buffer.drop(heap, realm_text);
    buffer.drop(heap, service_text);
    return (line, code);
}

// ---- referrers (OCI Distribution 1.1)

// The list of manifests that name `subject` as their subject, as an image index document: from the referrers API
// (`GET /v2/<name>/referrers/<digest>`, `artifactType` as a filter when `filter` is not empty), or, for a registry
// that has none (it answers 404), from the fallback tag `sha256-<hex>` (an index this tool and others keep). A registry
// that has neither is an empty list. The index is not filtered by the fallback: filter the descriptors you read.
// The document and 0, or an empty buffer and a refusal.
pub fn referrers_fetch[&h, &n, &t, &a, &r, &s, &f, &tl](heap: &!h Heap, net: &n Net(""), eng: &!tl tls.Engine, now_ms: int, host: &t [byte], port: int, auth: &a [byte], repo: &r [byte], subject: &s [byte], filter: &f [byte]) -> [heap, net_out(""), conn_read, conn_write] (buffer.Buffer, int, bool) {
    var out = buffer.empty(heap, 1);
    var code = 0;
    if len(subject) != 71 || !digest.equal(subject[0..7], "sha256:") {
        return (out, refused_digest(), false);
    }
    var path = api_path(heap, repo, "referrers", subject);
    if len(filter) > 0 {
        path = buffer.append(heap, path, "?artifactType=");
        path = query_value(heap, path, filter);
    }
    var found = false;
    var extra = buffer.append(heap, buffer.empty(heap, 256), auth);
    extra = buffer.append(heap, extra, "Accept: application/vnd.oci.image.index.v1+json\r\n");
    borrow extra as &eb in {
        borrow path as &pb in {
            let (reply, c) = round_trip_get(heap, net, eng, now_ms, host, port, buffer.bytes(eb), buffer.bytes(pb), 1048576);
            code = c;
            if c == 0 {
                borrow reply as &rr in {
                    let s2 = reply_status(rr);
                    if s2 == 200 {
                        buffer.drop(heap, out);
                        out = buffer.append(heap, buffer.empty(heap, len(reply_body(rr)) + 1), reply_body(rr));
                        found = true;
                    } else if s2 != 404 {
                        code = refusal_of(rr);
                    }
                }
            }
            drop_reply(heap, reply);
        }
    }
    buffer.drop(heap, extra);
    buffer.drop(heap, path);
    if code == 0 && !found {
        // the fallback tag: sha256-<hex>
        var tag = buffer.append(heap, buffer.empty(heap, 80), "sha256-");
        tag = buffer.append(heap, tag, subject[7..71]);
        region w {
            let shown = alloc_slice[w](71, byte_of(0));
            borrow tag as &tb in {
                let (doc, c2) = manifest_fetch(heap, net, eng, now_ms, host, port, auth, repo, buffer.bytes(tb), shown);
                if c2 == 0 {
                    buffer.drop(heap, out);
                    out = doc;
                } else {
                    buffer.drop(heap, doc);
                    if c2 != refused_not_found() {
                        code = c2;
                    }
                }
            }
        }
        buffer.drop(heap, tag);
        var nothing = false;
        borrow out as &ob0 in {
            nothing = len(buffer.bytes(ob0)) <= 1;
        }
        if code == 0 && nothing {
            buffer.drop(heap, out);
            out = buffer.append(heap, buffer.empty(heap, 96), "{\"schemaVersion\":2,\"mediaType\":\"application/vnd.oci.image.index.v1+json\",\"manifests\":[]}");
        }
    }
    if code != 0 {
        buffer.drop(heap, out);
        return (buffer.empty(heap, 1), code, found);
    }
    return (out, 0, found);
}

pub fn refused_referrers() -> [] int {
    return 0 - 917;
}

// Make `manifest` (an artifact whose subject is `subject`) findable among the subject's referrers. A registry that
// implements the referrers API lists it by itself once the manifest is pushed; for one that does not, the fallback tag
// `sha256-<hex>` holds an index of them, and this adds the artifact to it (read, add, write: two writers at once can lose
// one of the entries; the spec says so too). Entries already there are copied with their `mediaType`, `digest`, `size` and
// `artifactType`; an entry with anything else on it (annotations) is not rewritten, because that would drop the rest: it is
// refused (`registry-referrers-unreadable`). 0, or a refusal.
pub fn referrers_register[&h, &n, &t, &a, &r, &s, &m, &d, &y, &tl](heap: &!h Heap, net: &n Net(""), eng: &!tl tls.Engine, now_ms: int, host: &t [byte], port: int, auth: &a [byte], repo: &r [byte], subject: &s [byte], manifest_digest: &m [byte], manifest_size: int, artifact_type: &y [byte]) -> [heap, net_out(""), conn_read, conn_write] int {
    let (listed, c0, from_api) = referrers_fetch(heap, net, eng, now_ms, host, port, auth, repo, subject, "");
    var code = c0;
    if code == 0 && from_api {
        // the registry keeps the list; it must be there
        var there = false;
        borrow listed as &lb in {
            region a {
                let doc = buffer.bytes(lb);
                let tape = alloc_slice[a](layout.tape_ints(doc), 0);
                if json.parse(doc, tape) >= 0 {
                    let list = json.get(doc, tape, 0, "manifests");
                    var k = 0;
                    while list >= 0 && json.is_array(tape, list) && k < json.count(tape, list) {
                        if digest.equal(layout.text_of(doc, tape, json.at(tape, list, k), "digest"), manifest_digest) {
                            there = true;
                        }
                        k = k + 1;
                    }
                }
            }
        }
        if !there {
            code = refused_referrers();
        }
    } else if code == 0 {
        var w1 = json.writer(heap, 512);
        w1 = json.begin_object(heap, w1);
        w1 = json.put_key(heap, w1, "schemaVersion");
        w1 = json.put_int(heap, w1, 2);
        w1 = json.put_key(heap, w1, "mediaType");
        w1 = json.put_string(heap, w1, "application/vnd.oci.image.index.v1+json");
        w1 = json.put_key(heap, w1, "manifests");
        w1 = json.begin_array(heap, w1);
        var present = false;
        borrow listed as &lb2 in {
            region a2 {
                let doc = buffer.bytes(lb2);
                let tape = alloc_slice[a2](layout.tape_ints(doc), 0);
                if json.parse(doc, tape) < 0 {
                    code = refused_referrers();
                } else {
                    let list = json.get(doc, tape, 0, "manifests");
                    if list < 0 || !json.is_array(tape, list) {
                        code = refused_referrers();
                    }
                    var k = 0;
                    while code == 0 && k < json.count(tape, list) {
                        let entry = json.at(tape, list, k);
                        let em = layout.text_of(doc, tape, entry, "mediaType");
                        let ed = layout.text_of(doc, tape, entry, "digest");
                        let es = layout.number_of(doc, tape, entry, "size");
                        let et = layout.text_of(doc, tape, entry, "artifactType");
                        var members = 3;
                        if len(et) > 0 {
                            members = 4;
                        }
                        if len(em) == 0 || len(ed) != 71 || es < 0 || json.count(tape, entry) != members {
                            code = refused_referrers();
                        } else {
                            if digest.equal(ed, manifest_digest) {
                                present = true;
                            }
                            w1 = json.begin_object(heap, w1);
                            w1 = json.put_key(heap, w1, "mediaType");
                            w1 = json.put_string(heap, w1, em);
                            w1 = json.put_key(heap, w1, "digest");
                            w1 = json.put_string(heap, w1, ed);
                            w1 = json.put_key(heap, w1, "size");
                            w1 = json.put_int(heap, w1, es);
                            if len(et) > 0 {
                                w1 = json.put_key(heap, w1, "artifactType");
                                w1 = json.put_string(heap, w1, et);
                            }
                            w1 = json.end_object(heap, w1);
                        }
                        k = k + 1;
                    }
                }
            }
        }
        if code == 0 && !present {
            w1 = json.begin_object(heap, w1);
            w1 = json.put_key(heap, w1, "mediaType");
            w1 = json.put_string(heap, w1, "application/vnd.oci.image.manifest.v1+json");
            w1 = json.put_key(heap, w1, "digest");
            w1 = json.put_string(heap, w1, manifest_digest);
            w1 = json.put_key(heap, w1, "size");
            w1 = json.put_int(heap, w1, manifest_size);
            w1 = json.put_key(heap, w1, "artifactType");
            w1 = json.put_string(heap, w1, artifact_type);
            w1 = json.end_object(heap, w1);
        }
        w1 = json.end_array(heap, w1);
        w1 = json.end_object(heap, w1);
        let index = json.finish(w1);
        if code == 0 {
            var tag = buffer.append(heap, buffer.empty(heap, 80), "sha256-");
            tag = buffer.append(heap, tag, subject[7..71]);
            borrow tag as &tb in {
                borrow index as &ib in {
                    region a3 {
                        let sum = alloc_slice[a3](32, byte_of(0));
                        digest.of_bytes(buffer.bytes(ib), sum);
                        let text = alloc_slice[a3](71, byte_of(0));
                        digest.text_into(sum, text);
                        code = manifest_put(heap, net, eng, now_ms, host, port, auth, repo, buffer.bytes(tb), "application/vnd.oci.image.index.v1+json", buffer.bytes(ib), text);
                    }
                }
            }
            buffer.drop(heap, tag);
        }
        buffer.drop(heap, index);
    }
    buffer.drop(heap, listed);
    return code;
}
