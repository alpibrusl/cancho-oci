edition 5;

module oci.gzip;

// `oci.gzip` -- a deterministic gzip encoder (design 5.6, task #6): LZ77 with
// hash chains and the fixed Huffman code of RFC 1951, framed as RFC 1952.
//
// Determinism is the point: the header carries no time, no file name and a fixed
// "unknown" OS byte, and the compressed bytes are a pure function of the input,
// so a layer compresses to the same digest on every machine.
//
// It works a block at a time. Input is copied into a 64 KiB `pending` buffer;
// when that is full it is compressed as one non-final DEFLATE block, whose matches
// reach back only into the same block (a window never crosses a block, so a repeat
// across a 64 KiB boundary is a literal: a small loss, measured in design 5.6).
// `finish` compresses the rest, ends the stream with an empty final block, and
// appends the CRC-32 and the length.
//
// The caller owns the output: after every `feed` and `finish`, take `output(gz)`
// (a slice of the encoder's buffer), write it wherever it goes, and call
// `drained(gz)` before the next call.

pub fn block_len() -> [] int {
    return 65536;
}

// The most one call can leave in the output buffer: a block of 9-bit literals
// (65536 * 9 / 8 = 73728 bytes), the 10-byte header, the 3 + 7 bits of the closing
// block, and the 8-byte trailer, with slack.
pub fn out_cap() -> [] int {
    return 73728 + 128;
}

static crc_table: [int] {
    let t = alloc_slice[static](256, 0);
    var n = 0;
    while n < 256 {
        var c = n;
        var k = 0;
        while k < 8 {
            if c & 1 == 1 {
                c = 0xEDB88320 ^ c >> 1;
            } else {
                c = c >> 1;
            }
            k = k + 1;
        }
        t[n] = c;
        n = n + 1;
    }
    return t;
}

// RFC 1951 3.2.5: length codes 257..285 (29 of them) and distance codes 0..29.
// Built from the rule, not typed: after the first few, each group of codes adds
// one extra bit, and a code's base is the previous base plus the range it covered.
static len_extra: [int] {
    let t = alloc_slice[static](29, 0);
    var i = 8;
    while i < 28 {
        t[i] = (i - 4) / 4;
        i = i + 1;
    }
    return t;
}

static len_base: [int] {
    let t = alloc_slice[static](29, 0);
    t[0] = 3;
    var i = 1;
    while i < 28 {
        t[i] = t[i - 1] + (1 << len_extra[i - 1]);
        i = i + 1;
    }
    t[28] = 258;
    return t;
}

static dist_extra: [int] {
    let t = alloc_slice[static](30, 0);
    var i = 4;
    while i < 30 {
        t[i] = (i - 2) / 2;
        i = i + 1;
    }
    return t;
}

static dist_base: [int] {
    let t = alloc_slice[static](30, 0);
    t[0] = 1;
    var i = 1;
    while i < 30 {
        t[i] = t[i - 1] + (1 << dist_extra[i - 1]);
        i = i + 1;
    }
    return t;
}

// `n` bits of `code`, in the opposite order: Huffman codes are packed most
// significant bit first, into a stream that is filled least significant bit first.
fn rev(code: int, n: int) -> [] int {
    var out = 0;
    var i = 0;
    var c = code;
    while i < n {
        out = out << 1 | c & 1;
        c = c >> 1;
        i = i + 1;
    }
    return out;
}

// The fixed literal/length code (RFC 1951 3.2.6), already reversed for packing.
static lit_code: [int] {
    let t = alloc_slice[static](288, 0);
    var v = 0;
    while v < 288 {
        if v < 144 {
            t[v] = rev(0x30 + v, 8);
        } else if v < 256 {
            t[v] = rev(0x190 + v - 144, 9);
        } else if v < 280 {
            t[v] = rev(v - 256, 7);
        } else {
            t[v] = rev(0xC0 + v - 280, 8);
        }
        v = v + 1;
    }
    return t;
}

fn lit_bits(v: int) -> [] int {
    if v < 144 {
        return 8;
    }
    if v < 256 {
        return 9;
    }
    if v < 280 {
        return 7;
    }
    return 8;
}

// State slots, in one int slice so it can be moved and borrowed as a unit:
//   0 bit buffer   1 bits in it   2 bytes in the output   3 running crc (inverted)
//   4 uncompressed bytes so far   5 bytes in `pending`
pub fn state_len() -> [] int {
    return 8;
}

// Append `count` bits of `value` (least significant first) to the output.
fn put[&s, &o](st: &!s [int], out: &!o [byte], value: int, count: int) -> [] int {
    var buf = st[0] | value << st[1];
    var n = st[1] + count;
    var at = st[2];
    while n >= 8 {
        out[at] = byte_of(buf & 255);
        at = at + 1;
        buf = buf >> 8;
        n = n - 8;
    }
    st[0] = buf;
    st[1] = n;
    st[2] = at;
    return 0;
}

fn put_literal[&s, &o](st: &!s [int], out: &!o [byte], v: int) -> [] int {
    return put(st, out, lit_code[v], lit_bits(v));
}

fn put_match[&s, &o](st: &!s [int], out: &!o [byte], length: int, dist: int) -> [] int {
    var li = 28;
    while li > 0 && len_base[li] > length {
        li = li - 1;
    }
    put(st, out, lit_code[257 + li], lit_bits(257 + li));
    if len_extra[li] > 0 {
        put(st, out, length - len_base[li], len_extra[li]);
    }
    var di = 29;
    while di > 0 && dist_base[di] > dist {
        di = di - 1;
    }
    put(st, out, rev(di, 5), 5);
    if dist_extra[di] > 0 {
        put(st, out, dist - dist_base[di], dist_extra[di]);
    }
    return 0;
}

fn hash3[&p](data: &p [byte], i: int) -> [] int {
    return (int_of(data[i]) << 10 ^ int_of(data[i + 1]) << 5 ^ int_of(data[i + 2])) & 32767;
}

// The longest earlier match for the bytes at `i` that is within 32768 behind,
// following at most `chain` links. Answers length * 65536 + distance (0 when no
// match of 3 or more).
fn find[&p, &h, &q](data: &p [byte], n: int, i: int, head: &h [int], prev: &q [int], chain: int) -> [] int {
    if i + 3 > n {
        return 0;
    }
    var cand = head[hash3(data, i)] - 1;
    var best_len = 0;
    var best_dist = 0;
    var steps = 0;
    while cand >= 0 && steps < chain {
        let d = i - cand;
        if d > 32768 {
            return best_len * 65536 + best_dist;
        }
        var l = 0;
        while l < 258 && i + l < n && data[cand + l] == data[i + l] {
            l = l + 1;
        }
        if l > best_len {
            best_len = l;
            best_dist = d;
            if l == 258 {
                return best_len * 65536 + best_dist;
            }
        }
        cand = prev[cand] - 1;
        steps = steps + 1;
    }
    if best_len < 3 {
        return 0;
    }
    return best_len * 65536 + best_dist;
}

fn insert[&p, &h, &q](data: &p [byte], n: int, i: int, head: &!h [int], prev: &!q [int]) -> [] int {
    if i + 3 <= n {
        let k = hash3(data, i);
        prev[i] = head[k];
        head[k] = i + 1;
    }
    return 0;
}

// One non-final block of `n` bytes of `data`, with the fixed code.
fn compress_block[&s, &o, &p, &h, &q](st: &!s [int], out: &!o [byte], data: &p [byte], n: int, head: &!h [int], prev: &!q [int]) -> [] int {
    // BFINAL = 0, BTYPE = 01 (fixed Huffman), least significant bit first.
    put(st, out, 2, 3);
    var z = 0;
    while z < 32768 {
        head[z] = 0;
        z = z + 1;
    }
    var i = 0;
    while i < n {
        let found = find(data, n, i, head, prev, 48);
        var length = found / 65536;
        var dist = found % 65536;
        if length >= 3 && length < 32 {
            // Lazy matching: a longer match starting one byte later is worth a literal now.
            insert(data, n, i, head, prev);
            let next = find(data, n, i + 1, head, prev, 48);
            if next / 65536 > length {
                put_literal(st, out, int_of(data[i]));
                i = i + 1;
                length = 0;
            } else {
                var k = 1;
                put_match(st, out, length, dist);
                while k < length {
                    insert(data, n, i + k, head, prev);
                    k = k + 1;
                }
                i = i + length;
                length = 0 - 1;
            }
        } else if length >= 32 {
            put_match(st, out, length, dist);
            var k = 0;
            while k < length {
                insert(data, n, i + k, head, prev);
                k = k + 1;
            }
            i = i + length;
        } else {
            put_literal(st, out, int_of(data[i]));
            insert(data, n, i, head, prev);
            i = i + 1;
        }
    }
    // End of block: symbol 256.
    put_literal(st, out, 256);
    return 0;
}

// Incompressible data (a layer holding an already-compressed file) would grow
// under the fixed code, whose literals above 143 take nine bits. So a block that
// came out larger than storing it is replaced by stored blocks (RFC 1951 3.2.4):
// a 3-bit header, padding to a byte, LEN and its complement, then the bytes, at
// most 65535 at a time.
fn put_stored[&s, &o, &p](st: &!s [int], out: &!o [byte], data: &p [byte], n: int) -> [] int {
    var at = 0;
    while at < n {
        var chunk = n - at;
        if chunk > 65535 {
            chunk = 65535;
        }
        put(st, out, 0, 3);
        if st[1] > 0 {
            put(st, out, 0, 8 - st[1]);
        }
        var o = st[2];
        out[o] = byte_of(chunk & 255);
        out[o + 1] = byte_of(chunk >> 8 & 255);
        out[o + 2] = byte_of(65535 - chunk & 255);
        out[o + 3] = byte_of(65535 - chunk >> 8 & 255);
        o = o + 4;
        var k = 0;
        while k < chunk {
            out[o + k] = data[at + k];
            k = k + 1;
        }
        st[2] = o + chunk;
        at = at + chunk;
    }
    return 0;
}

// Compress the block; if that is not smaller than storing it, store it instead.
fn emit_block[&s, &o, &p, &h, &q](st: &!s [int], out: &!o [byte], data: &p [byte], n: int, head: &!h [int], prev: &!q [int]) -> [] int {
    let bits0 = st[0];
    let count0 = st[1];
    let at0 = st[2];
    compress_block(st, out, data, n, head, prev);
    let produced = (st[2] - at0) * 8 + st[1] - count0;
    if produced > n * 8 + 48 {
        st[0] = bits0;
        st[1] = count0;
        st[2] = at0;
        put_stored(st, out, data, n);
    }
    return 0;
}

// The encoder: its state, the block being collected, the output, and the two
// hash tables the matcher uses.
pub res struct Gz {
    st: Box[[int]],
    pending: Box[[byte]],
    out: Box[[byte]],
    head: Box[[int]],
    prev: Box[[int]],
}

pub fn begin[&h](heap: &!h Heap) -> [heap] Gz {
    let st = box_slice(heap, 8, 0);
    let out = box_slice(heap, 73856, byte_of(0));
    borrow mut st as &!sw in {
        let s = contents(sw);
        s[3] = 0xFFFFFFFF;
        borrow mut out as &!ow in {
            let o = contents(ow);
            // 1f 8b: gzip; 08: deflate; flags 0; mtime 0; xfl 0; OS 255 (unknown).
            o[0] = byte_of(31);
            o[1] = byte_of(139);
            o[2] = byte_of(8);
            o[9] = byte_of(255);
            s[2] = 10;
        }
    }
    return Gz { st: st, pending: box_slice(heap, 65536, byte_of(0)), out: out, head: box_slice(heap, 32768, 0), prev: box_slice(heap, 65536, 0) };
}

// Take bytes of `bytes` into the encoder; answers the encoder and how many were
// taken. When a block fills it is compressed and the call returns, so the caller
// can drain the output before offering the rest.
pub fn feed[&b](gz: Gz, bytes: &b [byte]) -> [] (Gz, int) {
    let Gz { st, pending, out, head, prev } = gz;
    var taken = 0;
    borrow mut st as &!sw in {
        let s = contents(sw);
        borrow mut pending as &!pw in {
            let p = contents(pw);
            var used = s[5];
            var crc = s[3];
            while taken < len(bytes) && used < 65536 {
                let c = int_of(bytes[taken]);
                p[used] = bytes[taken];
                crc = crc_table[(crc ^ c) & 255] ^ crc >> 8;
                used = used + 1;
                taken = taken + 1;
            }
            s[3] = crc;
            s[4] = s[4] + taken;
            s[5] = used;
            if used == 65536 {
                borrow mut out as &!ow in {
                    borrow mut head as &!hw in {
                        borrow mut prev as &!qw in {
                            emit_block(s, contents(ow), p, 65536, contents(hw), contents(qw));
                        }
                    }
                }
                s[5] = 0;
            }
        }
    }
    return (Gz { st: st, pending: pending, out: out, head: head, prev: prev }, taken);
}

// Compress what is left, close the stream (an empty final block, the byte
// boundary, the CRC-32 and the length) and leave it in the output.
pub fn finish(gz: Gz) -> [] Gz {
    let Gz { st, pending, out, head, prev } = gz;
    borrow mut st as &!sw in {
        let s = contents(sw);
        borrow mut out as &!ow in {
            let o = contents(ow);
            if s[5] > 0 {
                borrow pending as &pr in {
                    borrow mut head as &!hw in {
                        borrow mut prev as &!qw in {
                            emit_block(s, o, contents(pr), s[5], contents(hw), contents(qw));
                        }
                    }
                }
                s[5] = 0;
            }
            // BFINAL = 1, BTYPE = 01, then the end-of-block symbol of an empty block.
            put(s, o, 3, 3);
            put_literal(s, o, 256);
            if s[1] > 0 {
                put(s, o, 0, 8 - s[1]);
            }
            let crc = s[3] ^ 0xFFFFFFFF;
            let size = s[4] & 0xFFFFFFFF;
            var k = 0;
            while k < 4 {
                o[s[2] + k] = byte_of(crc >> k * 8 & 255);
                o[s[2] + 4 + k] = byte_of(size >> k * 8 & 255);
                k = k + 1;
            }
            s[2] = s[2] + 8;
        }
    }
    return Gz { st: st, pending: pending, out: out, head: head, prev: prev };
}

// The bytes produced so far and not yet drained.
pub fn output[&g](gz: &g Gz) -> [] &g [byte] {
    return contents(gz.out)[0..contents(gz.st)[2]];
}

// Forget the bytes the caller has taken from `output`.
pub fn drained(gz: Gz) -> [] Gz {
    let Gz { st, pending, out, head, prev } = gz;
    borrow mut st as &!sw in {
        contents(sw)[2] = 0;
    }
    return Gz { st: st, pending: pending, out: out, head: head, prev: prev };
}

pub fn drop[&h](heap: &!h Heap, gz: Gz) -> [heap] int {
    let Gz { st, pending, out, head, prev } = gz;
    unbox_slice(heap, st);
    unbox_slice(heap, pending);
    unbox_slice(heap, out);
    unbox_slice(heap, head);
    unbox_slice(heap, prev);
    return 0;
}
