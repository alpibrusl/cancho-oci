edition 7;

import std.buffer;
import std.io;
import std.json;
import oci.digest;
import oci.image;
import oci.layout;
import oci.registry;
import oci.store;

// oci-pull: fetch an image from a registry into an OCI layout (design 5.7, task #9).
//
//     oci-pull --registry <host[:port]> --repo <name> --ref <tag-or-digest> --out <image-dir>
//              --plain-http [--platform linux/<arch>] [--basic-file <path>]
//
// Nothing the registry sends is believed. The digest of every manifest is computed here and
// must be the one asked for (and the one the registry reports, if it reports one); every blob is
// downloaded into a temporary file, checked for size and digest, and only then published under
// its name; a blob already in the layout and intact is not fetched again. The manifest that names
// the blobs is stored after them, and `index.json` last, so a pull that stops early leaves no
// manifest pointing at a missing blob. With `--platform` only that platform of a multi-platform
// image is fetched, and the layout's entry is that image; without it, every platform is.
//
// `--plain-http` is required for now (TLS is the next step of task #9). A refusal is
// `refused: <rule tag>` on stderr and exit status 1; `<image-dir>/blobs/sha256` must already exist.

fn pull_flag() -> [] int {
    return 0 - 1101;
}

fn pull_missing() -> [] int {
    return 0 - 1102;
}

fn pull_plain() -> [] int {
    return 0 - 1103;
}

fn pull_creds_http() -> [] int {
    return 0 - 1104;
}

fn pull_registry() -> [] int {
    return 0 - 1105;
}

fn pull_ref() -> [] int {
    return 0 - 1106;
}

fn pull_dir() -> [] int {
    return 0 - 1107;
}

fn pull_skeleton() -> [] int {
    return 0 - 1108;
}

fn pull_document() -> [] int {
    return 0 - 1109;
}

fn pull_platform() -> [] int {
    return 0 - 1110;
}

fn rule_of(code: int) -> [] &static [byte] {
    if code == pull_flag() {
        return "pull-flag";
    }
    if code == pull_missing() {
        return "pull-missing";
    }
    if code == pull_plain() {
        return "pull-plain-http-required";
    }
    if code == pull_creds_http() {
        return "pull-credentials-over-plain-http";
    }
    if code == pull_registry() {
        return "pull-registry";
    }
    if code == pull_ref() {
        return "pull-ref";
    }
    if code == pull_dir() {
        return "pull-dir-open";
    }
    if code == pull_skeleton() {
        return "pull-layout-skeleton";
    }
    if code == pull_document() {
        return "pull-document";
    }
    if code == pull_platform() {
        return "pull-platform";
    }
    if code <= 0 - 600 && code > 0 - 700 {
        return layout.rule_name(code);
    }
    if code <= 0 - 200 && code > 0 - 300 {
        return image.rule_name(code);
    }
    if code <= 0 - 800 && code > 0 - 1000 {
        return registry.rule_name(code);
    }
    return store.rule_name(code);
}

fn refuse[&i, &n](io: &!i Io, code: int, culprit: &n [byte]) -> [err_write] int {
    io.error_all(io, "refused: ");
    io.error_all(io, rule_of(code));
    if len(culprit) > 0 {
        io.error_all(io, " (");
        io.error_all(io, culprit);
        io.error_all(io, ")");
    }
    io.error_all(io, "\n");
    return 1;
}

// Bring one blob into the layout unless an intact copy of the right size is already there.
fn want_blob[&h, &n, &t, &a, &r, &d, &b, &i](heap: &!h Heap, net: &n Net(""), host: &t [byte], port: int, auth: &a [byte], repo: &r [byte], digest_text: &d [byte], size: int, blobs: &b Dir, io: &!i Io) -> [heap, net_out(""), conn_read, conn_write, dir_read, dir_write, file_read, file_write, io_write] int {
    let hex = layout.hex_of(digest_text);
    if len(hex) == 0 || size < 0 {
        return pull_document();
    }
    let (have, actual) = store.verify_sized(heap, blobs, hex);
    if have == 0 && actual == size {
        io.write_all(io, "blob ");
        io.write_all(io, digest_text);
        io.write_all(io, " already here\n");
        return 0;
    }
    let code = registry.blob_fetch(heap, net, host, port, auth, repo, digest_text, size, blobs, ".incoming-pull");
    if code == 0 {
        io.write_all(io, "blob ");
        io.write_all(io, digest_text);
        io.write_all(io, " fetched (");
        io.print_nat(io, size);
        io.write_all(io, " bytes)\n");
    }
    return code;
}

// A manifest's config and layers, then the manifest document itself.
fn take_image[&h, &n, &t, &a, &r, &d, &b, &i](heap: &!h Heap, net: &n Net(""), host: &t [byte], port: int, auth: &a [byte], repo: &r [byte], doc: &d [byte], blobs: &b Dir, io: &!i Io) -> [heap, net_out(""), conn_read, conn_write, dir_read, dir_write, file_read, file_write, io_write] int {
    var code = 0;
    region a2 {
        let tape = alloc_slice[a2](json.tape_len(doc), 0);
        if json.parse(doc, tape) < 0 {
            code = layout.refused_json();
        } else if !digest.equal(layout.text_of(doc, tape, 0, "mediaType"), image.media_manifest()) {
            code = registry.refused_media();
        } else {
            let cfg = json.get(doc, tape, 0, "config");
            let layers = json.get(doc, tape, 0, "layers");
            if cfg < 0 || layers < 0 || !json.is_array(tape, layers) || json.count(tape, layers) < 1 {
                code = pull_document();
            } else {
                code = want_blob(heap, net, host, port, auth, repo, layout.text_of(doc, tape, cfg, "digest"), layout.number_of(doc, tape, cfg, "size"), blobs, io);
                var l = 0;
                while code == 0 && l < json.count(tape, layers) {
                    let node = json.at(tape, layers, l);
                    code = want_blob(heap, net, host, port, auth, repo, layout.text_of(doc, tape, node, "digest"), layout.number_of(doc, tape, node, "size"), blobs, io);
                    l = l + 1;
                }
                if code == 0 {
                    code = keep_document(heap, blobs, doc);
                }
            }
        }
    }
    return code;
}

// Store a document under its digest. (`manifest_fetch` has already proved the bytes have the digest it
// was asked for or reported, so `store.put` naming them by their own digest is the same name.)
fn keep_document[&h, &d, &b](heap: &!h Heap, blobs: &d Dir, doc: &b [byte]) -> [heap, dir_write, file_write] int {
    var code = 0;
    region a {
        let raw = alloc_slice[a](32, byte_of(0));
        let outcome = store.put(heap, blobs, ".incoming-0", doc, raw);
        if outcome <= 0 {
            code = outcome;
        }
    }
    return code;
}

// Does the platform entry `node` of an index match `want` ("linux/arm64")?
fn platform_matches[&s, &t, &w](src: &s [byte], tape: &t [int], node: int, want: &w [byte]) -> [] bool {
    let p = json.get(src, tape, node, "platform");
    if p < 0 {
        return false;
    }
    let os = layout.text_of(src, tape, p, "os");
    let arch = layout.text_of(src, tape, p, "architecture");
    let slash = index_of_byte(want, byte_of('/'));
    if slash < 1 {
        return false;
    }
    return digest.equal(os, want[0..slash]) && digest.equal(arch, want[slash + 1..len(want)]);
}

fn assemble[&h, &n, &t, &a, &r, &x, &p, &d, &b, &i, &k](heap: &!h Heap, net: &n Net(""), host: &t [byte], port: int, auth: &a [byte], repo: &r [byte], reference: &x [byte], platform: &p [byte], image_dir: &d Dir, blobs: &b Dir, io: &!i Io, tag: &k [byte]) -> [heap, net_out(""), conn_read, conn_write, dir_read, dir_write, file_read, file_write, io_write, err_write] int {
    var status = 1;
    region w {
        let shown = alloc_slice[w](71, byte_of(0));
        let top_text = alloc_slice[w](71, byte_of(0));
        var code = 0;
        var top_size = 0;
        var top_media = image.media_manifest();
        let (doc, c0) = registry.manifest_fetch(heap, net, host, port, auth, repo, reference, shown);
        code = c0;
        if code == 0 {
            borrow doc as &db in {
                let body = buffer.bytes(db);
                region v {
                    let tape = alloc_slice[v](json.tape_len(body), 0);
                    if json.parse(body, tape) < 0 {
                        code = layout.refused_json();
                    } else {
                        let media = layout.text_of(body, tape, 0, "mediaType");
                        if digest.equal(media, image.media_manifest()) {
                            if len(platform) > 0 {
                                code = pull_platform();
                            } else {
                                code = take_image(heap, net, host, port, auth, repo, body, blobs, io);
                                top_size = len(body);
                                var k = 0;
                                while k < 71 {
                                    top_text[k] = shown[k];
                                    k = k + 1;
                                }
                            }
                        } else if digest.equal(media, image.media_index()) {
                            let kids = json.get(body, tape, 0, "manifests");
                            if kids < 0 || !json.is_array(tape, kids) || json.count(tape, kids) < 1 {
                                code = pull_document();
                            }
                            var chosen = 0;
                            var m = 0;
                            while code == 0 && m < json.count(tape, kids) {
                                let kid = json.at(tape, kids, m);
                                if len(platform) == 0 || platform_matches(body, tape, kid, platform) {
                                    chosen = chosen + 1;
                                    let kid_digest = layout.text_of(body, tape, kid, "digest");
                                    let kid_shown = alloc_slice[w](71, byte_of(0));
                                    let (kid_doc, c1) = registry.manifest_fetch(heap, net, host, port, auth, repo, kid_digest, kid_shown);
                                    code = c1;
                                    if code == 0 {
                                        borrow kid_doc as &kb in {
                                            code = take_image(heap, net, host, port, auth, repo, buffer.bytes(kb), blobs, io);
                                            if len(platform) > 0 && code == 0 {
                                                // a single platform: the layout's entry is that image, not the index
                                                top_size = len(buffer.bytes(kb));
                                                var k = 0;
                                                while k < 71 {
                                                    top_text[k] = kid_shown[k];
                                                    k = k + 1;
                                                }
                                            }
                                        }
                                    }
                                    buffer.drop(heap, kid_doc);
                                }
                                m = m + 1;
                            }
                            if code == 0 && chosen == 0 {
                                code = pull_platform();
                            }
                            if code == 0 && len(platform) == 0 {
                                code = keep_document(heap, blobs, body);
                                top_size = len(body);
                                top_media = image.media_index();
                                var k = 0;
                                while k < 71 {
                                    top_text[k] = shown[k];
                                    k = k + 1;
                                }
                            }
                        } else {
                            code = registry.refused_media();
                        }
                    }
                }
            }
        }
        buffer.drop(heap, doc);
        if code == 0 {
            let (entry, c2) = image.layout_entry_json(heap, top_media, top_text, top_size, tag);
            code = c2;
            if code == 0 {
                borrow entry as &eb in {
                    if image.write_file(image_dir, "index.json", buffer.bytes(eb)) != 0 {
                        code = store.refused_io();
                    }
                }
                if code == 0 && image.write_file(image_dir, "oci-layout", image.layout_text()) != 0 {
                    code = store.refused_io();
                }
            }
            buffer.drop(heap, entry);
        }
        if code == 0 {
            io.write_all(io, top_text);
            io.write_all(io, "\n");
            status = 0;
        } else {
            status = refuse(io, code, "");
        }
    }
    return status;
}

fn with_dirs[&h, &f, &n, &i, &t, &a, &r, &x, &p, &k](heap: &!h Heap, fs: &f Fs(""), net: &n Net(""), io: &!i Io, out_path: &static [byte], host: &t [byte], port: int, auth: &a [byte], repo: &r [byte], reference: &x [byte], platform: &p [byte], tag: &k [byte]) -> [heap, fs_read(""), net_out(""), conn_read, conn_write, dir_read, dir_write, file_read, file_write, io_write, err_write] int {
    var status = 1;
    match open_dir(fs, out_path) {
        DirOpened::Failed(errno) => {
            status = refuse(io, pull_dir(), out_path);
        }
        DirOpened::Ok(top) => {
            var image_dir = top;
            borrow image_dir as &id in {
                match dir_enter(id, "blobs") {
                    DirOpened::Failed(errno) => {
                        status = refuse(io, pull_skeleton(), out_path);
                    }
                    DirOpened::Ok(blobs_dir) => {
                        var blobs = blobs_dir;
                        borrow blobs as &bd in {
                            match dir_enter(bd, "sha256") {
                                DirOpened::Failed(errno) => {
                                    status = refuse(io, pull_skeleton(), out_path);
                                }
                                DirOpened::Ok(sha_dir) => {
                                    var sha = sha_dir;
                                    borrow sha as &sd in {
                                        status = assemble(heap, net, host, port, auth, repo, reference, platform, id, sd, io, tag);
                                    }
                                    dir_close(sha);
                                }
                            }
                        }
                        dir_close(blobs);
                    }
                }
            }
            dir_close(image_dir);
        }
    }
    return status;
}

fn run[&h, &f, &n, &i, &g](heap: &!h Heap, fs: &f Fs(""), net: &n Net(""), io: &!i Io, args: &g Args) -> [heap, args, fs_read(""), net_out(""), conn_read, conn_write, dir_read, dir_write, file_read, file_write, io_write, err_write] int {
    var out_path = "";
    var registry_text = "";
    var repo = "";
    var reference = "";
    var platform = "";
    var basic_file = "";
    var plain = false;
    var bad = "";
    var at = 1;
    while at < arg_count(args) && len(bad) == 0 {
        let flag = arg(args, at);
        if digest.equal(flag, "--plain-http") {
            plain = true;
            at = at + 1;
        } else if at + 1 >= arg_count(args) {
            bad = flag;
        } else {
            let value = arg(args, at + 1);
            if digest.equal(flag, "--out") {
                out_path = value;
            } else if digest.equal(flag, "--registry") {
                registry_text = value;
            } else if digest.equal(flag, "--repo") {
                repo = value;
            } else if digest.equal(flag, "--ref") {
                reference = value;
            } else if digest.equal(flag, "--platform") {
                platform = value;
            } else if digest.equal(flag, "--basic-file") {
                basic_file = value;
            } else {
                bad = flag;
            }
            at = at + 2;
        }
    }
    if len(bad) > 0 {
        return refuse(io, pull_flag(), bad);
    }
    if len(out_path) == 0 || len(registry_text) == 0 || len(repo) == 0 || len(reference) == 0 {
        return refuse(io, pull_missing(), "--registry, --repo, --ref and --out are required");
    }
    if !plain {
        return refuse(io, pull_plain(), "TLS is not wired in yet; pass --plain-http to pull over plain HTTP");
    }
    if !registry.name_ok(repo) {
        return refuse(io, registry.refused_name(), repo);
    }
    if !registry.reference_ok(reference) {
        return refuse(io, pull_ref(), reference);
    }
    var host = registry_text;
    var port = 80;
    let colon = index_of_byte(registry_text, byte_of(':'));
    if colon >= 0 {
        host = registry_text[0..colon];
        port = registry.port_of(registry_text[colon + 1..len(registry_text)]);
    }
    if len(host) == 0 || port < 0 || index_of_byte(host, byte_of('/')) >= 0 || index_of_byte(host, byte_of('@')) >= 0 {
        return refuse(io, pull_registry(), registry_text);
    }
    if len(platform) > 0 && index_of_byte(platform, byte_of('/')) < 1 {
        return refuse(io, pull_platform(), platform);
    }
    if len(basic_file) > 0 && !registry.is_loopback(host) {
        return refuse(io, pull_creds_http(), host);
    }
    var auth = buffer.empty(heap, 1);
    if len(basic_file) > 0 {
        let (creds, c) = registry.read_credentials(heap, fs, basic_file);
        if c != 0 {
            buffer.drop(heap, creds);
            buffer.drop(heap, auth);
            return refuse(io, c, basic_file);
        }
        borrow creds as &cb in {
            buffer.drop(heap, auth);
            auth = registry.auth_line(heap, buffer.bytes(cb));
        }
        buffer.drop(heap, creds);
    }
    // The layout's tag annotation is the reference when it is a tag, and nothing when it is a digest.
    var tag = reference;
    if len(reference) == 71 && digest.equal(reference[0..7], "sha256:") {
        tag = reference[0..0];
    }
    var status = 1;
    borrow auth as &ab in {
        status = with_dirs(heap, fs, net, io, out_path, host, port, buffer.bytes(ab), repo, reference, platform, tag);
    }
    buffer.drop(heap, auth);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi);
    release(clock);
    release(signals);
    release(exec);
    var status = 1;
    borrow mut heap as &!h in {
        borrow args as &g in {
            borrow fs as &f in {
                borrow net as &n in {
                    borrow mut io as &!i in {
                        status = run(h, f, n, i, g);
                    }
                }
            }
        }
    }
    release(heap);
    release(args);
    release(fs);
    release(net);
    release(io);
    return status;
}
